<% layout('layout') %>

<style>
  :root {
    --bg-body: #1E1F25;
    --bg-card: #282A32;
    --bg-card-hover: #32343D;
    --border-color: #3A3C45;
    --text-primary: #FFFFFF;
    --text-secondary: #9CA3B0;
    --text-muted: #6B7280;
    --green-accent: #BFFF00;
    --blue-accent: #6366F1;
  }

  .navbar { display: none !important; }
  .footer-wave, .footer { display: block !important; }
  .main-content { display: contents !important; max-width: none !important; margin: 0 !important; padding: 0 !important; }
  
  body {
    background: var(--bg-body) !important;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text-primary);
  }
  
  .dashboard-container {
    background: var(--bg-body);
    display: block;
    min-height: 100vh;
    padding: 24px;
    padding: 24px;
    /* padding-left: 94px; - Removed */
  }

  /* Sidebar - use fixed from sidebar.ejs */
  .left-sidebar { position: fixed !important; left: 0 !important; top: 0 !important; }
  .sidebar-header, .sidebar-brand, .profile-section, .profile-avatar-large, .profile-title, .profile-subtitle, .nav-text, .subscription-indicator { display: none !important; }

  .main-content-area { padding: 0 40px; width: 100%; }

  .page-header { margin-bottom: 32px; }
  .back-link { display: inline-flex; align-items: center; gap: 8px; color: var(--blue-accent); text-decoration: none; font-size: 14px; margin-bottom: 20px; margin-left: 0; }
  .back-link:hover { text-decoration: underline; }
  .page-title { font-size: 28px; font-weight: 700; margin: 0 0 8px 0; }
  .page-subtitle { font-size: 14px; color: var(--text-muted); margin: 0; }

  .alert { padding: 14px 18px; border-radius: 12px; margin-bottom: 24px; font-size: 14px; display: flex; align-items: center; gap: 10px; }
  .alert-success { background: rgba(191, 255, 0, 0.1); border: 1px solid rgba(191, 255, 0, 0.3); color: var(--green-accent); }
  .alert-error { background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #EF4444; }

  .section { background: var(--bg-card); border-radius: 16px; padding: 28px; margin-bottom: 24px; }
  .section-title { font-size: 18px; font-weight: 600; margin-bottom: 8px; display: flex; align-items: center; gap: 10px; }
  .section-desc { font-size: 14px; color: var(--text-secondary); margin-bottom: 24px; }

  .toggle-list { display: flex; flex-direction: column; gap: 16px; }
  .toggle-item { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; background: var(--bg-body); border-radius: 12px; }
  .toggle-info h4 { font-size: 15px; font-weight: 600; margin: 0 0 4px 0; }
  .toggle-info p { font-size: 13px; color: var(--text-muted); margin: 0; }

  .toggle-switch { position: relative; width: 52px; height: 28px; }
  .toggle-switch input { opacity: 0; width: 0; height: 0; }
  .toggle-slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background: var(--border-color); border-radius: 28px; transition: 0.3s; }
  .toggle-slider:before { position: absolute; content: ""; height: 22px; width: 22px; left: 3px; bottom: 3px; background: white; border-radius: 50%; transition: 0.3s; }
  input:checked + .toggle-slider { background: var(--green-accent); }
  input:checked + .toggle-slider:before { transform: translateX(24px); }

  .btn { padding: 12px 28px; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; border: none; transition: all 0.2s; }
  .btn-primary { background: var(--green-accent); color: #000; }
  .btn-primary:hover { background: #D4FF33; transform: translateY(-1px); }
  .btn-secondary { background: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border-color); text-decoration: none; display: inline-block; }
  .btn-secondary:hover { background: var(--bg-card-hover); }
  .button-row { display: flex; gap: 12px; margin-top: 28px; }
</style>

<div class="dashboard-container">
  <%- include('partials/sidebar', { activePage: 'settings' }) %>

  <main class="main-content-area">
    <a href="/settings" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Back to Settings
    </a>

    <div class="page-header">
      <h1 class="page-title">Notification Preferences</h1>
      <p class="page-subtitle">Choose how you want to be notified about your code reviews</p>
    </div>

    <% if (success) { %>
    <div class="alert alert-success">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      Preferences saved successfully!
    </div>
    <% } %>

    <% if (error) { %>
    <div class="alert alert-error">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="15" y1="9" x2="9" y2="15"></line>
        <line x1="9" y1="9" x2="15" y2="15"></line>
      </svg>
      <%= error %>
    </div>
    <% } %>

    <form method="POST" action="/notification-preferences">
      <div class="section">
        <div class="section-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
          </svg>
          Email Notifications
        </div>
        <p class="section-desc">Control which notifications you receive via email</p>

        <div class="toggle-list">
          <div class="toggle-item">
            <div class="toggle-info">
              <h4>Email Notifications</h4>
              <p>Receive email notifications for important updates</p>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" name="emailNotifications" <%= user.notifications?.email !== false ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <div class="toggle-item">
            <div class="toggle-info">
              <h4>PR Comments</h4>
              <p>Get notified when Peer comments on your pull requests</p>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" name="prComments" <%= user.notifications?.prComments !== false ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <div class="toggle-item">
            <div class="toggle-info">
              <h4>Auto-Fix Updates</h4>
              <p>Receive updates when auto-fixes are applied to your code</p>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" name="autoFix" <%= user.notifications?.autoFix !== false ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>

          <div class="toggle-item">
            <div class="toggle-info">
              <h4>Weekly Digest</h4>
              <p>Get a weekly summary of your code review activity</p>
            </div>
            <label class="toggle-switch">
              <input type="checkbox" name="weeklyDigest" <%= user.notifications?.weeklyDigest ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </label>
          </div>
        </div>
      </div>

      <div class="button-row">
        <button type="submit" class="btn btn-primary">Save Preferences</button>
        <a href="/settings" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </main>
</div>
