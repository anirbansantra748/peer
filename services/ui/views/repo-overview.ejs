<% layout('layout') %>

<style>
  :root {
    --bg-body: #121212;
    --bg-dashboard: #121212;
    --bg-card: #1A1A1A;
    --bg-card-hover: #202020;
    --border-color: #2A2A2A;
    --text-primary: #FFFFFF;
    --text-secondary: #9CA3AF;
    --text-muted: #6B7280;
    
    --green-accent: #4CD964;
    --green-badge-bg: rgba(76, 217, 100, 0.1);
    --yellow-badge: #FFD700;
    --cyan-accent: #00E0FF;
    --blue-accent: #0A84FF;
    --red-accent: #FF5F56;
  }

  /* Override Layout Defaults */
  .navbar { display: none !important; }
  .footer-wave, .footer { display: block !important; }
  .main-content {
    max-width: none !important; margin: 0 !important; padding: 0 !important;
    min-height: auto !important; display: contents !important;
  }
  body {
    background: var(--bg-body) !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text-primary);
    padding: 0 !important; margin: 0 !important;
    min-height: 100vh; display: block;
  }
  
  .dashboard-container {
    background: var(--bg-dashboard);
    display: block;
    width: 100%;
    min-height: 100vh;
    padding: 24px;
    /* padding-left: 94px; - Removed to prevent double padding */
  }

  /* Sidebar - use fixed from sidebar.ejs */
  .left-sidebar {
    position: fixed !important;
    left: 0 !important;
    top: 0 !important;
  }
  
  /* Hide old sidebar elements */
  .sidebar-header, .sidebar-brand, .profile-section, .profile-avatar-large, 
  .profile-title, .profile-subtitle, .nav-text, .subscription-indicator {
    display: none !important;
  }


  .grid-main-content {
    min-width: 0;
    padding: 0 32px;
  }

  /* Page Header */
  .page-header {
    margin: 32px 0 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .page-title {
    font-size: 24px;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Top Stats Section */
  .overview-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 40px;
  }
  
  .overview-card {
    background: var(--bg-card);
    border-radius: 16px;
    padding: 24px;
    border: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 120px;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }
  .overview-card:hover {
    transform: translateY(-4px);
    border-color: #3a3a3a;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }
  
  .overview-value-group {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  .overview-value {
    font-size: 32px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
  }
  .overview-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
  }
  .icon-blue { background: rgba(10, 132, 255, 0.1); color: var(--blue-accent); }
  .icon-green { background: rgba(76, 217, 100, 0.1); color: var(--green-accent); }
  .icon-yellow { background: rgba(255, 215, 0, 0.1); color: var(--yellow-badge); }
  .icon-red { background: rgba(255, 95, 86, 0.1); color: var(--red-accent); }
  
  .overview-label {
    font-size: 13px;
    color: var(--text-secondary);
    margin-top: 12px;
    font-weight: 500;
  }

  /* Search Bar */
  .search-bar-container {
    margin-bottom: 24px;
    position: relative;
  }
  .search-input {
    width: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 14px 20px 14px 44px;
    color: var(--text-primary);
    font-size: 14px;
    transition: all 0.2s;
  }
  .search-input:focus {
    outline: none;
    border-color: var(--text-secondary);
  }
  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
  }

  /* Repos Grid - Exactly 2 per row */
  .repos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    padding-bottom: 40px;
  }
  
  .repo-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 24px;
    transition: all 0.2s ease;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .repo-card:hover {
    background: var(--bg-card-hover);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
  }
  
  .repo-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
  }
  
  .repo-title-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .repo-avatar {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: #2a2a2a;
  }
  .repo-name {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }
  
  .mode-badge {
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 20px;
    background: rgba(42, 42, 42, 0.5);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    white-space: nowrap;
  }
  
  /* Repo Stats Grid */
  .card-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 20px;
  }
  
  .card-stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .card-stat-label {
    font-size: 12px;
    color: var(--text-muted);
  }
  .card-stat-value {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .value-green { color: var(--green-accent); }
  .value-blue { color: var(--blue-accent); }
  
  .repo-footer {
    border-top: 1px solid var(--border-color);
    padding-top: 16px;
    margin-top: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: var(--text-muted);
  }
  
  .view-details-btn {
    background: var(--green-accent);
    color: #000;
    padding: 6px 16px;
    border-radius: 20px;
    font-weight: 600;
    font-size: 12px;
    border: none;
    cursor: pointer;
  }
  
  @media (max-width: 1200px) {
    .dashboard-container { grid-template-columns: 1fr; }
    .left-sidebar { display: none; } /* Hide sidebar on small screens if not mobile responsive yet */
  }
</style>

<div class="dashboard-container">
  <!-- Sidebar -->
  <%- include('partials/sidebar', { activePage: 'repos' }) %>
  
  <!-- Main Content -->
  <main class="grid-main-content">
    
    <!-- Header -->
    <div class="page-header">
      <div class="page-title">Repository Overview</div>
    </div>

    <!-- Top Stats Cards -->
    <div class="overview-stats-grid">
      <div class="overview-card">
        <div class="overview-value-group">
          <div class="overview-value"><%= totalRepos %></div>
          <div class="overview-icon icon-blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
          </div>
        </div>
        <div class="overview-label">Total Repositories</div>
        <!-- Mini Graph -->
        <svg width="100%" height="32" viewBox="0 0 100 32" preserveAspectRatio="none" style="margin-top: 12px;">
          <defs>
            <linearGradient id="gradient-repos" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:#0A84FF;stop-opacity:0.2" />
              <stop offset="100%" style="stop-color:#0A84FF;stop-opacity:0" />
            </linearGradient>
          </defs>
          <path d="M0,20 L20,18 L40,16 L60,14 L80,12 L100,10 L100,32 L0,32 Z" fill="url(#gradient-repos)" />
          <polyline points="0,20 20,18 40,16 60,14 80,12 100,10" stroke="#0A84FF" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="0" cy="20" r="2" fill="#0A84FF" />
          <circle cx="20" cy="18" r="2" fill="#0A84FF" />
          <circle cx="40" cy="16" r="2" fill="#0A84FF" />
          <circle cx="60" cy="14" r="2" fill="#0A84FF" />
          <circle cx="80" cy="12" r="2" fill="#0A84FF" />
          <circle cx="100" cy="10" r="2.5" fill="#0A84FF" />
        </svg>
      </div>
      
      <div class="overview-card">
        <div class="overview-value-group">
          <div class="overview-value"><%= totalPRs %></div>
          <div class="overview-icon icon-yellow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          </div>
        </div>
        <div class="overview-label">Total PRs Analyzed</div>
        <!-- Mini Graph -->
        <svg width="100%" height="32" viewBox="0 0 100 32" preserveAspectRatio="none" style="margin-top: 12px;">
          <defs>
            <linearGradient id="gradient-prs" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:#FFD700;stop-opacity:0.2" />
              <stop offset="100%" style="stop-color:#FFD700;stop-opacity:0" />
            </linearGradient>
          </defs>
          <path d="M0,22 L20,19 L40,20 L60,16 L80,14 L100,11 L100,32 L0,32 Z" fill="url(#gradient-prs)" />
          <polyline points="0,22 20,19 40,20 60,16 80,14 100,11" stroke="#FFD700" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="0" cy="22" r="2" fill="#FFD700" />
          <circle cx="20" cy="19" r="2" fill="#FFD700" />
          <circle cx="40" cy="20" r="2" fill="#FFD700" />
          <circle cx="60" cy="16" r="2" fill="#FFD700" />
          <circle cx="80" cy="14" r="2" fill="#FFD700" />
          <circle cx="100" cy="11" r="2.5" fill="#FFD700" />
        </svg>
      </div>
      
      <div class="overview-card">
        <div class="overview-value-group">
          <div class="overview-value"><%= totalIssues %></div>
          <div class="overview-icon icon-red">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          </div>
        </div>
        <div class="overview-label">Total Issues Found</div>
        <!-- Mini Graph -->
        <svg width="100%" height="32" viewBox="0 0 100 32" preserveAspectRatio="none" style="margin-top: 12px;">
          <defs>
            <linearGradient id="gradient-issues" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:#FF5F56;stop-opacity:0.2" />
              <stop offset="100%" style="stop-color:#FF5F56;stop-opacity:0" />
            </linearGradient>
          </defs>
          <path d="M0,16 L20,17 L40,19 L60,18 L80,20 L100,22 L100,32 L0,32 Z" fill="url(#gradient-issues)" />
          <polyline points="0,16 20,17 40,19 60,18 80,20 100,22" stroke="#FF5F56" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="0" cy="16" r="2" fill="#FF5F56" />
          <circle cx="20" cy="17" r="2" fill="#FF5F56" />
          <circle cx="40" cy="19" r="2" fill="#FF5F56" />
          <circle cx="60" cy="18" r="2" fill="#FF5F56" />
          <circle cx="80" cy="20" r="2" fill="#FF5F56" />
          <circle cx="100" cy="22" r="2.5" fill="#FF5F56" />
        </svg>
      </div>
      
      <div class="overview-card">
        <div class="overview-value-group">
          <div class="overview-value"><%= totalFixed %></div>
          <div class="overview-icon icon-green">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
        </div>
        <div class="overview-label">Issues Fixed</div>
        <!-- Mini Graph -->
        <svg width="100%" height="32" viewBox="0 0 100 32" preserveAspectRatio="none" style="margin-top: 12px;">
          <defs>
            <linearGradient id="gradient-fixed" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:#4CD964;stop-opacity:0.2" />
              <stop offset="100%" style="stop-color:#4CD964;stop-opacity:0" />
            </linearGradient>
          </defs>
          <path d="M0,26 L20,22 L40,18 L60,14 L80,11 L100,8 L100,32 L0,32 Z" fill="url(#gradient-fixed)" />
          <polyline points="0,26 20,22 40,18 60,14 80,11 100,8" stroke="#4CD964" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="0" cy="26" r="2" fill="#4CD964" />
          <circle cx="20" cy="22" r="2" fill="#4CD964" />
          <circle cx="40" cy="18" r="2" fill="#4CD964" />
          <circle cx="60" cy="14" r="2" fill="#4CD964" />
          <circle cx="80" cy="11" r="2" fill="#4CD964" />
          <circle cx="100" cy="8" r="2.5" fill="#4CD964" />
        </svg>
      </div>
    </div>

    <!-- Search/Filter -->
    <div class="search-bar-container">
      <span class="search-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </span>
      <input type="text" class="search-input" placeholder="Search Repositories..." id="repoSearch" oninput="filterRepos(this.value)">
    </div>

    <!-- Repos Grid -->
    <div class="repos-grid">
      <% repos.forEach(repo => { %>
        <div class="repo-card" onclick="window.location.href='/repo/<%= repo.name %>'">
          <!-- Header -->
          <div class="repo-header">
            <div class="repo-title-group">
              <img src="https://github.com/<%= repo.name.split('/')[0] %>.png" class="repo-avatar" alt="">
              <div class="repo-name"><%= repo.name %></div>
            </div>
            <!-- Top Right Statistic (Matches reference '0 percent' or similar status) -->
            <div style="font-size: 11px; color: var(--text-muted); font-weight: 500;">
              <%= repo.modeName %>
            </div>
          </div>
          
          <!-- Inner Dark Card Look -->
          <div style="background: rgba(0,0,0,0.2); border-radius: 12px; padding: 20px; margin-bottom: 0;">
            
            <!-- Row 1: Stats & Time -->
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
              <!-- Left: PRs -->
              <div style="display: flex; gap: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center; color: var(--text-secondary);">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                </div>
                <div>
                  <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 4px;">Total PRs</div>
                  <div style="font-size: 13px; color: var(--text-secondary);">
                     <span style="color: var(--text-primary); font-weight: 600;"><%= repo.totalPRs %> Analyzed</span>
                  </div>
                </div>
              </div>

              <!-- Middle: Issues -->
              <div style="text-align: right; padding-right: 20px;">
                <div style="font-size: 14px; font-weight: 600; color: var(--text-primary); margin-bottom: 4px;">
                  <%= repo.totalIssues %> Found / <%= repo.issuesSolved %> Fixed
                </div>
                <div style="font-size: 11px; color: var(--text-muted);">
                   Fix Rate: <%= repo.fixRate %>%
                </div>
              </div>

              <!-- Right: Activity -->
              <div style="display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-secondary);">
                <div style="width: 8px; height: 8px; background: <%= repo.successRate >= 80 ? '#4CD964' : (repo.successRate >= 50 ? '#0A84FF' : '#FF5F56') %>; border-radius: 50%;"></div>
                <span><%= new Date(repo.lastActivity).toLocaleDateString() %></span>
              </div>
            </div>

            <!-- Row 2: Stats and Button -->
             <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-top: 24px;">
                <div style="display: flex; gap: 40px;">
                   <!-- Fix Rate -->
                   <div>
                     <div style="font-size: 24px; font-weight: 700; color: var(--text-primary); margin-bottom: 4px;">
                       <%= repo.fixRate %>%
                     </div>
                     <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Fix Rate</div>
                   </div>
                   <!-- Success Rate -->
                   <div>
                     <div style="font-size: 24px; font-weight: 700; color: var(--text-primary); margin-bottom: 4px;">
                       <%= repo.successRate %>%
                     </div>
                     <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Success Rate</div>
                   </div>
                </div>

                <!-- View Details Button -->
                <button class="view-details-btn" style="padding: 10px 24px; font-size: 13px; border-radius: 24px;">
                  View Details
                </button>
             </div>

          </div>
        </div>
      <% }) %>
      
      <% if (repos.length === 0) { %>
        <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: var(--text-muted);">
          No repositories found.
        </div>
      <% } %>
    </div>
    
  </main>
</div>

<script>
  // Repository search/filter functionality
  function filterRepos(query) {
    const cards = document.querySelectorAll('.repo-card');
    const lowerQuery = query.toLowerCase().trim();
    
    cards.forEach(card => {
      const repoName = card.querySelector('.repo-name');
      if (repoName) {
        const name = repoName.textContent.toLowerCase();
        if (lowerQuery === '' || name.includes(lowerQuery)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      }
    });
  }
</script>
