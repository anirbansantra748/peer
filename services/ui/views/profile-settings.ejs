<% layout('layout') %>

<style>
  :root {
    --bg-body: #1E1F25;
    --bg-card: #282A32;
    --bg-card-hover: #32343D;
    --border-color: #3A3C45;
    --text-primary: #FFFFFF;
    --text-secondary: #9CA3B0;
    --text-muted: #6B7280;
    --green-accent: #BFFF00;
    --blue-accent: #6366F1;
  }

  .navbar { display: none !important; }
  .footer-wave, .footer { display: block !important; }
  .main-content { display: contents !important; max-width: none !important; margin: 0 !important; padding: 0 !important; }
  
  body {
    background: var(--bg-body) !important;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text-primary);
  }
  
  .dashboard-container {
    background: var(--bg-body);
    display: block;
    min-height: 100vh;
    padding: 24px;
    padding: 24px;
    /* padding-left: 94px; - Removed */
  }

  /* Sidebar - use fixed from sidebar.ejs */
  .left-sidebar { position: fixed !important; left: 0 !important; top: 0 !important; }
  .sidebar-header, .sidebar-brand, .profile-section, .profile-avatar-large, .profile-title, .profile-subtitle, .nav-text, .subscription-indicator { display: none !important; }

  .main-content-area { padding: 0 40px; width: 100%; }

  .page-header { margin-bottom: 32px; }
  .back-link { display: inline-flex; align-items: center; gap: 8px; color: var(--blue-accent); text-decoration: none; font-size: 14px; margin-bottom: 20px; margin-left: 0; }
  .back-link:hover { text-decoration: underline; }
  .page-title { font-size: 28px; font-weight: 700; margin: 0 0 8px 0; }
  .page-subtitle { font-size: 14px; color: var(--text-muted); margin: 0; }

  .alert { padding: 14px 18px; border-radius: 12px; margin-bottom: 24px; font-size: 14px; display: flex; align-items: center; gap: 10px; }
  .alert-success { background: rgba(191, 255, 0, 0.1); border: 1px solid rgba(191, 255, 0, 0.3); color: var(--green-accent); }
  .alert-error { background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #EF4444; }

  .section { background: var(--bg-card); border-radius: 16px; padding: 28px; margin-bottom: 24px; }
  .section-title { font-size: 18px; font-weight: 600; margin-bottom: 8px; display: flex; align-items: center; gap: 10px; }
  .section-desc { font-size: 14px; color: var(--text-secondary); margin-bottom: 24px; }

  .user-card { display: flex; align-items: center; gap: 20px; padding: 20px; background: var(--bg-body); border-radius: 14px; margin-bottom: 24px; }
  .user-avatar { width: 72px; height: 72px; border-radius: 50%; border: 3px solid var(--border-color); }
  .user-info h3 { font-size: 18px; font-weight: 700; margin: 0 0 4px 0; }
  .user-info p { font-size: 14px; color: var(--text-muted); margin: 0; }
  .badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; text-transform: uppercase; }
  .badge-oauth { background: rgba(99, 102, 241, 0.15); color: var(--blue-accent); }

  .form-group { margin-bottom: 20px; }
  .form-group label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 8px; }
  .form-group input { width: 100%; padding: 12px 16px; background: var(--bg-body); border: 1px solid var(--border-color); border-radius: 10px; font-size: 14px; color: var(--text-primary); transition: border-color 0.2s; }
  .form-group input:focus { outline: none; border-color: var(--green-accent); }
  .input-helper { font-size: 12px; color: var(--text-muted); margin-top: 6px; }
  .input-info { display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: var(--bg-body); border: 1px solid var(--border-color); border-radius: 10px; font-size: 14px; color: var(--text-secondary); }

  .btn { padding: 12px 28px; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; border: none; transition: all 0.2s; }
  .btn-primary { background: var(--green-accent); color: #000; }
  .btn-primary:hover { background: #D4FF33; transform: translateY(-1px); }
  .btn-secondary { background: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border-color); text-decoration: none; display: inline-block; }
  .btn-secondary:hover { background: var(--bg-card-hover); }
  .button-row { display: flex; gap: 12px; margin-top: 28px; }
</style>

<div class="dashboard-container">
  <%- include('partials/sidebar', { activePage: 'settings' }) %>

  <main class="main-content-area">
    <a href="/settings" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Back to Settings
    </a>

    <div class="page-header">
      <h1 class="page-title">Profile Settings</h1>
      <p class="page-subtitle">Manage your profile information and notification email</p>
    </div>

    <% if (success) { %>
    <div class="alert alert-success">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      Settings saved successfully!
    </div>
    <% } %>

    <% if (error) { %>
    <div class="alert alert-error">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="15" y1="9" x2="9" y2="15"></line>
        <line x1="9" y1="9" x2="15" y2="15"></line>
      </svg>
      <%= error %>
    </div>
    <% } %>

    <div class="section">
      <div class="section-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        Your Profile
      </div>

      <div class="user-card">
        <img src="<%= user.avatar %>" alt="<%= user.username %>" class="user-avatar">
        <div class="user-info">
          <h3><%= user.displayName || user.username %></h3>
          <p>@<%= user.username %> · <span class="badge badge-oauth">GitHub OAuth</span></p>
        </div>
      </div>

      <form method="POST" action="/profile-settings">
        <div class="form-group">
          <label>GitHub Email</label>
          <div class="input-info">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span><%= user.email || 'Not provided by GitHub' %></span>
          </div>
          <p class="input-helper">This email is provided by GitHub OAuth and cannot be changed here.</p>
        </div>

        <div class="form-group">
          <label for="notificationEmail">Notification Email</label>
          <input 
            type="email" 
            id="notificationEmail" 
            name="notificationEmail" 
            value="<%= user.notificationEmail || user.email || '' %>"
            placeholder="Enter email for notifications"
            required
          >
          <p class="input-helper">This email will be used for PR notifications, approval requests, and alerts.</p>
        </div>

        <div class="button-row">
          <button type="submit" class="btn btn-primary">Save Changes</button>
          <a href="/settings" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</div>
