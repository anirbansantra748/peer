<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Peer Code Review</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        bg: {
                            main: '#050505',
                            card: '#0A0A0A',
                            border: '#1F1F1F',
                            sidebar: '#0F0F0F'
                        },
                        brand: {
                            primary: '#00FF94', // Electric Mint
                            accent: '#22C55E',  
                            danger: '#EF4444',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    backgroundImage: {
                        'grid-pattern': "linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px)",
                    },
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-10px)' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #050505;
            color: #E2E8F0;
            -webkit-font-smoothing: antialiased;
        }

        .grid-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: var(--tw-backgroundImage-grid-pattern);
            background-size: 60px 60px;
            z-index: -2;
            mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
            -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
            opacity: 0.6;
        }
    </style>
</head>
<body class="selection:bg-brand-primary selection:text-black min-h-screen flex items-center justify-center relative overflow-hidden">

    <!-- Background -->
    <div class="grid-bg"></div>
    
    <!-- Ambient Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-primary/5 blur-[100px] rounded-full pointer-events-none"></div>

    <!-- Login Card -->
    <div class="w-full max-w-md p-8 relative z-10">
        <!-- Card Container -->
        <div class="bg-[#0A0A0A] border border-[#1F1F1F] rounded-2xl shadow-2xl p-10 text-center relative overflow-hidden group hover:border-white/10 transition-colors duration-300">
            
            <!-- Top Gradient Line -->
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-brand-primary/50 to-transparent opacity-50"></div>

            <!-- Logo -->
            <div class="mb-8 flex justify-center">
                <a href="/" class="block hover:scale-105 transition-transform duration-300">
                    <img src="/7dfd4e47-c1f2-4bd9-af7a-cb7d54b2e772.jpg-output.png" alt="PRQueue" class="w-32 h-32 object-contain mx-auto">
                </a>
            </div>

            <h1 class="text-2xl font-bold text-white mb-2">Welcome Back</h1>
            <p class="text-gray-400 text-sm mb-10">Sign in to manage your autonomous code reviews.</p>

            <!-- Login Button -->
            <a href="/auth/github" class="group flex items-center justify-center gap-3 bg-white text-black w-full py-4 rounded-xl font-bold text-sm hover:bg-[#00FF94] transition-all shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:shadow-[0_0_30px_rgba(0,255,148,0.4)] hover:-translate-y-1">
                <i class="fa-brands fa-github text-xl"></i>
                <span class="group-hover:tracking-wide transition-all">Login with GitHub</span>
            </a>

            <!-- Footer Links -->
            <div class="mt-8 pt-8 border-t border-white/5 text-xs text-gray-500 flex justify-between items-center">
                <a href="/" class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-white/5 text-gray-500 hover:text-white transition-all">
                    <i class="fa-solid fa-arrow-left"></i> Back to Home
                </a>
                <div class="flex gap-4">
                    <a href="/terms" class="hover:text-white transition-colors">Terms</a>
                    <a href="/privacy" class="hover:text-white transition-colors">Privacy</a>
                </div>
            </div>
        </div>
        
        <!-- Copyright -->
        <div class="text-center mt-8 text-xs text-gray-600">
            &copy; 2026 PRQueue Inc. All rights reserved.
        </div>
    </div>

</body>
</html>
