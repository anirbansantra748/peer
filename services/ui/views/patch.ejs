<% layout('layout') %>

<style>
  :root {
    --bg-body: #121212;
    --bg-card: #1A1A1A;
    --border-color: #2A2A2A;
    --text-primary: #FFFFFF;
    --text-secondary: #9CA3AF;
    --text-muted: #6B7280;
    --green-accent: #4CD964;
    --red-accent: #FF5F56;
    --yellow-accent: #FFD700;
    --blue-accent: #0A84FF;
    --orange-accent: #FF9500;
  }

  .navbar { display: none !important; }
  .footer-wave, .footer { display: block !important; }
  .main-content {
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    min-height: auto !important;
    display: contents !important;
  }
  
  body {
    background: var(--bg-body) !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text-primary);
    padding: 0 !important;
    margin: 0 !important;
    min-height: 100vh;
  }

  .patch-container {
    display: block;
    min-height: 100vh;
    padding: 24px;
    padding: 24px;
    /* padding-left: 94px; - Removed */
  }

  /* Sidebar - use fixed from sidebar.ejs */
  .patch-container .left-sidebar {
    position: fixed !important;
    left: 0 !important;
    top: 0 !important;
  }
  /* Hide old sidebar elements */
  .patch-container .left-sidebar .sidebar-brand,
  .patch-container .left-sidebar .profile-section,
  .patch-container .left-sidebar .nav-text,
  .patch-container .left-sidebar .subscription-indicator,
  .sidebar-header, .profile-avatar-large, .profile-title, .profile-subtitle { 
    display: none !important; 
  }

  /* Main Content */
  .patch-main {
    padding: 0 24px;
    max-width: 1200px;
  }

  /* Page Header */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-color);
  }
  .page-title {
    font-size: 22px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .status-badge {
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }
  .status-badge.applying { background: rgba(10, 132, 255, 0.2); color: var(--blue-accent); }
  .status-badge.completed { background: rgba(76, 217, 100, 0.2); color: var(--green-accent); }
  .status-badge.failed { background: rgba(255, 95, 86, 0.2); color: var(--red-accent); }

  /* Success Box */
  .success-box {
    background: linear-gradient(135deg, rgba(76, 217, 100, 0.15), rgba(76, 217, 100, 0.05));
    border: 1px solid rgba(76, 217, 100, 0.3);
    border-radius: 16px;
    padding: 32px;
    text-align: center;
    margin-bottom: 24px;
  }
  .success-box .icon { font-size: 48px; margin-bottom: 16px; }
  .success-box h2 { color: var(--green-accent); font-size: 24px; margin-bottom: 8px; }
  .success-box p { color: var(--text-secondary); font-size: 14px; }

  /* Processing Box */
  .processing-box {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 24px;
  }
  .processing-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .processing-header .spinner {
    width: 20px;
    height: 20px;
    border: 2px solid var(--border-color);
    border-top-color: var(--blue-accent);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .processing-header h3 { color: var(--blue-accent); font-size: 16px; font-weight: 600; }
  .processing-box p { color: var(--text-muted); font-size: 13px; }

  /* Git Info Box */
  .git-info {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
  }
  .git-info h3 {
    font-size: 14px;
    color: var(--text-primary);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .git-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border-color);
  }
  .git-row:last-child { border-bottom: none; }
  .git-label { color: var(--text-muted); font-size: 12px; min-width: 60px; }
  .git-value {
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 12px;
    background: rgba(255, 255, 255, 0.05);
    padding: 6px 12px;
    border-radius: 6px;
    color: var(--text-secondary);
  }

  /* Results Grid */
  .results-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }
  .result-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
  }
  .result-header {
    padding: 16px;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .result-header.success { border-left: 4px solid var(--green-accent); }
  .result-header.warning { border-left: 4px solid var(--orange-accent); }
  .result-header.error { border-left: 4px solid var(--red-accent); }
  .result-header h3 { font-size: 14px; font-weight: 600; }
  .result-count {
    margin-left: auto;
    background: rgba(255, 255, 255, 0.1);
    padding: 4px 10px;
    border-radius: 10px;
    font-size: 11px;
    color: var(--text-muted);
  }
  .result-list {
    padding: 8px;
    max-height: 200px;
    overflow-y: auto;
  }
  .result-item {
    padding: 10px 12px;
    border-radius: 6px;
    margin-bottom: 4px;
    font-size: 12px;
    background: rgba(0, 0, 0, 0.2);
  }
  .result-item code {
    color: var(--blue-accent);
    background: none;
  }
  .result-item.applied { border-left: 3px solid var(--green-accent); }
  .result-item.skipped { border-left: 3px solid var(--orange-accent); }
  .result-item.error { border-left: 3px solid var(--red-accent); }
  .empty-state {
    padding: 20px;
    text-align: center;
    color: var(--text-muted);
    font-size: 12px;
  }

  /* Action Buttons */
  .action-bar {
    display: flex;
    gap: 12px;
    margin-top: 24px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }
  .btn-primary { background: var(--green-accent); color: #000; }
  .btn-primary:hover { background: #5FE574; }
  .btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }
  .btn-secondary:hover { background: rgba(255, 255, 255, 0.12); }
  .btn-blue { background: var(--blue-accent); color: #fff; }
  .btn-blue:hover { background: #1a8fff; }
</style>

<div class="patch-container">
  <%- include('partials/sidebar', { activePage: 'repos' }) %>
  
  <main class="patch-main">
    <!-- Page Header -->
    <div class="page-header">
      <div class="page-title">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        Patch Results
        <span class="status-badge <%= patch.status %>"><%= patch.status %></span>
      </div>
    </div>

    <% if (patch.status === 'completed') { %>
      <div class="success-box">
        <div class="icon">🎉</div>
        <h2>Fixes Applied Successfully!</h2>
        <p>Your changes have been committed and pushed. Redirecting to dashboard...</p>
      </div>
      <script>setTimeout(() => { window.location.href = '/'; }, 3000);</script>
    <% } %>

    <% if (patch.status !== 'completed' && patch.status !== 'failed') { %>
      <div class="processing-box">
        <div class="processing-header">
          <div class="spinner"></div>
          <h3>Patch is still processing...</h3>
        </div>
        <p>This page will automatically refresh when complete.</p>
      </div>
      <script>setTimeout(() => { window.location.reload(); }, 3000);</script>
    <% } %>

    <% if (patch.results) { %>
      <div class="git-info">
        <h3>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M12 1v6m0 6v10"></path></svg>
          Git Details
        </h3>
        <div class="git-row">
          <span class="git-label">Branch</span>
          <span class="git-value"><%= patch.results.branchName || '(n/a)' %></span>
        </div>
        <div class="git-row">
          <span class="git-label">Commit</span>
          <span class="git-value"><%= patch.results.commitSha || '(n/a)' %></span>
        </div>
      </div>

      <div class="results-grid">
        <div class="result-card">
          <div class="result-header success">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <h3>Applied</h3>
            <span class="result-count"><%= (patch.results.applied || []).length %></span>
          </div>
          <div class="result-list">
            <% if ((patch.results.applied || []).length === 0) { %>
              <div class="empty-state">No fixes applied</div>
            <% } else { %>
              <% (patch.results.applied || []).forEach(a => { %>
                <div class="result-item applied"><code><%= a.file %></code></div>
              <% }) %>
            <% } %>
          </div>
        </div>

        <div class="result-card">
          <div class="result-header warning">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            <h3>Skipped</h3>
            <span class="result-count"><%= (patch.results.skipped || []).length %></span>
          </div>
          <div class="result-list">
            <% if ((patch.results.skipped || []).length === 0) { %>
              <div class="empty-state">No issues skipped</div>
            <% } else { %>
              <% (patch.results.skipped || []).forEach(s => { %>
                <div class="result-item skipped"><code><%= s.file %></code> — <%= s.reason %></div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>

      <% if ((patch.results.errors || []).length) { %>
        <div class="result-card" style="margin-bottom: 20px;">
          <div class="result-header error">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
            <h3>Errors</h3>
            <span class="result-count"><%= (patch.results.errors || []).length %></span>
          </div>
          <div class="result-list">
            <% (patch.results.errors || []).forEach(err => { %>
              <div class="result-item error"><%= err.message %></div>
            <% }) %>
          </div>
        </div>
      <% } %>
    <% } %>

    <div class="action-bar">
      <a href="/" class="btn btn-secondary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to Dashboard
      </a>
      <a href="/runs/<%= runId %>/select" class="btn btn-secondary">Back to Selection</a>
      <% if (patch.status === 'completed' || patch.status === 'failed') { %>
        <form method="post" action="/runs/<%= runId %>/rerun" style="display: inline;">
          <input type="hidden" name="patchRequestId" value="<%= patchRequestId %>">
          <button type="submit" class="btn btn-blue">🔄 Re-run Fixes</button>
        </form>
      <% } %>
    </div>
  </main>
</div>
