<% layout('layout') %>

<style>
  :root {
    --bg-body: #121212;
    --bg-dashboard: #121212;
    --bg-card: #1A1A1A;
    --bg-card-hover: #202020;
    --border-color: #2A2A2A;
    --text-primary: #FFFFFF;
    --text-secondary: #9CA3AF;
    --text-muted: #6B7280;
    --green-accent: #4CD964;
    --yellow-badge: #FFD700;
    --blue-accent: #0A84FF;
    --orange-accent: #FF9500;
    --red-accent: #FF5F56;
  }

  .navbar {
    display: none !important;
  }
  
  .footer-wave, .footer {
    display: block !important;
  }

  .main-content {
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    min-height: auto !important;
    display: contents !important;
  }

  body {
    background: var(--bg-body) !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
    color: var(--text-primary);
  }
  
  .dashboard-container {
    background: var(--bg-dashboard);
    display: block;
    width: 100%;
    min-height: 100vh;
    padding: 24px;
    padding: 24px;
    /* padding-left: 94px; */
  }

  /* Sidebar - use fixed from sidebar.ejs */
  .left-sidebar {
    position: fixed !important;
    left: 0 !important;
    top: 0 !important;
  }
  
  /* Hide old sidebar elements */
  .sidebar-header, .sidebar-brand, .profile-section, .profile-avatar-large, 
  .profile-title, .profile-subtitle, .nav-text, .subscription-indicator {
    display: none !important;
  }

  .grid-main-content {
    padding: 0 40px 40px 40px;
    width: 100%;
  }

  /* Page Header */
  .page-header {
    margin-bottom: 32px;
  }
  
  .page-title {
    font-size: 32px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 8px 0;
    letter-spacing: -0.5px;
  }
  
  .page-subtitle {
    font-size: 15px;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Stats Row */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }

  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px;
  }

  .stat-label {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .stat-value {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .stat-desc {
    font-size: 13px;
    color: var(--text-secondary);
  }

  /* Alert */
  .alert {
    padding: 16px 20px;
    border-radius: 12px;
    margin-bottom: 24px;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .alert-warning {
    background: rgba(255, 149, 0, 0.1);
    border: 1px solid rgba(255, 149, 0, 0.3);
    color: var(--text-primary);
  }

  .alert-success {
    background: rgba(76, 217, 100, 0.1);
    border: 1px solid rgba(76, 217, 100, 0.3);
    color: var(--text-primary);
  }

  .alert a {
    color: var(--orange-accent);
    text-decoration: underline;
    font-weight: 600;
  }

  /* Section Header */
  .section-header {
    margin: 40px 0 20px 0;
  }

  .section-title {
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .section-desc {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Provider Cards */
  .provider-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 32px;
    margin-bottom: 24px;
    transition: all 0.2s;
  }

  .provider-card:hover {
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .provider-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  .provider-info {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .provider-logo {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    font-weight: 700;
  }

  .provider-logo.groq {
    background: linear-gradient(135deg, #4CD964 0%, #34C759 100%);
    color: #000;
  }

  .provider-logo.gemini {
    background: linear-gradient(135deg, #0A84FF 0%, #0066CC 100%);
    color: #fff;
  }

  .provider-details h3 {
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 6px 0;
  }

  .provider-details p {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0;
  }

  .status-badge {
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .status-active {
    background: rgba(76, 217, 100, 0.15);
    color: var(--green-accent);
  }

  .status-inactive {
    background: rgba(107, 114, 128, 0.2);
    color: var(--text-muted);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  /* Form */
  .form-grid {
    display: grid;
    gap: 20px;
  }

  .form-group label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .input-wrapper {
    position: relative;
  }

  input[type="password"],
  input[type="text"] {
    width: 100%;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1.5px solid var(--border-color);
    border-radius: 10px;
    color: var(--text-primary);
    font-size: 14px;
    font-family: 'Monaco', 'Menlo', monospace;
    transition: all 0.2s;
  }

  input:focus {
    outline: none;
    border-color: var(--blue-accent);
    background: rgba(255, 255, 255, 0.05);
  }

  input::placeholder {
    color: var(--text-muted);
  }

  .help-text {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    font-size: 13px;
    color: var(--text-secondary);
  }

  .help-link {
    color: var(--blue-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .help-link:hover {
    text-decoration: underline;
  }

  /* Buttons */
  .button-group {
    display: flex;
    gap: 12px;
    margin-top: 24px;
  }

  .btn {
    padding: 12px 24px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .btn-primary {
    background: var(--green-accent);
    color: #000;
  }

  .btn-primary:hover {
    background: #5FE574;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(76, 217, 100, 0.3);
  }

  .btn-danger {
    background: rgba(255, 95, 86, 0.15);
    color: var(--red-accent);
    border: 1px solid rgba(255, 95, 86, 0.3);
  }

  .btn-danger:hover {
    background: var(--red-accent);
    color: #fff;
    border-color: var(--red-accent);
  }

  /* Info Box */
  .info-box {
    background: rgba(10, 132, 255, 0.08);
    border: 1px solid rgba(10, 132, 255, 0.2);
    border-radius: 12px;
    padding: 20px;
    margin-top: 40px;
  }

  .info-box-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .info-box-content {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .feature-list {
    margin: 16px 0 0 0;
    padding: 0;
    list-style: none;
  }

  .feature-list li {
    padding: 8px 0;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .feature-list li::before {
    content: '✓';
    color: var(--green-accent);
    font-weight: 700;
    font-size: 16px;
  }
</style>

<div class="dashboard-container">
  <%- include('partials/sidebar', { activePage: 'apikeys' }) %>
  
  <main class="grid-main-content">
    <!-- Page Header -->
    <div class="page-header">
      <h1 class="page-title">API Keys</h1>
      <p class="page-subtitle">Connect your own AI provider keys to use your credits</p>
    </div>

    <!-- Stats Row -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-label">Active Keys</div>
        <div class="stat-value"><%= (user.apiKeys?.groq ? 1 : 0) + (user.apiKeys?.gemini ? 1 : 0) %></div>
        <div class="stat-desc">Connected API providers</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Token Usage</div>
        <div class="stat-value"><%= Math.round((user.tokensUsed / user.tokenLimit) * 100) %>%</div>
        <div class="stat-desc"><%= user.tokensUsed.toLocaleString() %> / <%= user.tokenLimit.toLocaleString() %> tokens used</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Available Providers</div>
        <div class="stat-value">2</div>
        <div class="stat-desc">Groq & Gemini integrations</div>
      </div>
    </div>

    <!-- Alerts -->
    <% if (user.tokensUsed >= user.tokenLimit && !user.apiKeys?.groq && !user.apiKeys?.gemini) { %>
    <div class="alert alert-warning">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
        <line x1="12" y1="9" x2="12" y2="13"></line>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
      <div>
        You've reached your token limit. Add your own API keys below or 
        <a href="/settings/subscription">upgrade your plan</a>.
      </div>
    </div>
    <% } %>

    <% if (query.success) { %>
    <div class="alert alert-success">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <div><%= query.success %></div>
    </div>
    <% } %>

    <!-- Section Header -->
    <div class="section-header">
      <h2 class="section-title">AI Provider Connections</h2>
      <p class="section-desc">
        Connect API keys from your preferred AI providers. Your keys are encrypted and only used for code analysis.
      </p>
    </div>

    <!-- Groq Provider Card -->
    <div class="provider-card">
      <div class="provider-header">
        <div class="provider-info">
          <div class="provider-logo groq">⚡</div>
          <div class="provider-details">
            <h3>Groq</h3>
            <p>Lightning-fast inference with Llama 3 models</p>
          </div>
        </div>
        <% if (user.apiKeys?.groq) { %>
          <span class="status-badge status-active">
            <span class="status-dot"></span>
            Active
          </span>
        <% } else { %>
          <span class="status-badge status-inactive">
            <span class="status-dot"></span>
            Not Connected
          </span>
        <% } %>
      </div>

      <form action="/settings/api-keys/groq" method="POST" class="form-grid">
        <div class="form-group">
          <label for="groq-key">API Key</label>
          <div class="input-wrapper">
            <input
              type="password"
              id="groq-key"
              name="apiKey"
              placeholder="<%= user.apiKeys?.groq ? '••••••••••••••••••••••••••••' : 'gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx' %>"
            />
          </div>
          <div class="help-text">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <a href="https://console.groq.com/keys" target="_blank" class="help-link">
              Get your free Groq API key →
            </a>
          </div>
        </div>
        <div class="button-group">
          <button type="submit" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <% if (user.apiKeys?.groq) { %>
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              <% } else { %>
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              <% } %>
            </svg>
            <%= user.apiKeys?.groq ? 'Update Key' : 'Connect Groq' %>
          </button>
          <% if (user.apiKeys?.groq) { %>
          <button type="button" onclick="removeKey('groq')" class="btn btn-danger">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
            Remove
          </button>
          <% } %>
        </div>
      </form>
    </div>

    <!-- Gemini Provider Card -->
    <div class="provider-card">
      <div class="provider-header">
        <div class="provider-info">
          <div class="provider-logo gemini">✦</div>
          <div class="provider-details">
            <h3>Google Gemini</h3>
            <p>Advanced code analysis with Gemini Pro models</p>
          </div>
        </div>
        <% if (user.apiKeys?.gemini) { %>
          <span class="status-badge status-active">
            <span class="status-dot"></span>
            Active
          </span>
        <% } else { %>
          <span class="status-badge status-inactive">
            <span class="status-dot"></span>
            Not Connected
          </span>
        <% } %>
      </div>

      <form action="/settings/api-keys/gemini" method="POST" class="form-grid">
        <div class="form-group">
          <label for="gemini-key">API Key</label>
          <div class="input-wrapper">
            <input
              type="password"
              id="gemini-key"
              name="apiKey"
              placeholder="<%= user.apiKeys?.gemini ? '••••••••••••••••••••••••••••' : 'AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX' %>"
            />
          </div>
          <div class="help-text">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <a href="https://aistudio.google.com/app/apikey" target="_blank" class="help-link">
              Get your free Gemini API key →
            </a>
          </div>
        </div>
        <div class="button-group">
          <button type="submit" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <% if (user.apiKeys?.gemini) { %>
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              <% } else { %>
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              <% } %>
            </svg>
            <%= user.apiKeys?.gemini ? 'Update Key' : 'Connect Gemini' %>
          </button>
          <% if (user.apiKeys?.gemini) { %>
          <button type="button" onclick="removeKey('gemini')" class="btn btn-danger">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
            Remove
          </button>
          <% } %>
        </div>
      </form>
    </div>

    <!-- Info Box -->
    <div class="info-box">
      <div class="info-box-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        Security & Privacy
      </div>
      <div class="info-box-content">
        <p style="margin: 0 0 12px 0;">
          Your API keys are encrypted at rest and in transit. We implement industry-standard security practices:
        </p>
        <ul class="feature-list">
          <li>Keys are encrypted using AES-256 encryption</li>
          <li>Only used for your authorized code analysis requests</li>
          <li>Never logged or shared with third parties</li>
          <li>Can be removed at any time</li>
        </ul>
      </div>
    </div>
  </main>
</div>

<script>
  function removeKey(provider) {
    if (confirm(`Are you sure you want to remove your ${provider.toUpperCase()} API key?`)) {
      fetch(`/settings/api-keys/${provider}`, {
        method: 'DELETE'
      }).then(res => {
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to remove key. Please try again.');
        }
      }).catch(err => {
        alert('An error occurred. Please try again.');
      });
    }
  }
</script>
