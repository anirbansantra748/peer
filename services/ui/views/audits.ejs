<% layout('layout') %>

<style>
  :root {
    --bg-body: #121212;
    --bg-dashboard: #121212;
    --bg-card: #1A1A1A;
    --bg-card-hover: #202020;
    --border-color: #2A2A2A;
    --text-primary: #FFFFFF;
    --text-secondary: #9CA3AF;
    --text-muted: #6B7280;
    --green-accent: #4CD964;
    --green-badge-bg: rgba(76, 217, 100, 0.1);
    --yellow-badge: #FFD700;
    --cyan-accent: #00E0FF;
    --blue-accent: #0A84FF;
    --orange-accent: #FF9500;
    --red-accent: #FF5F56;
  }

  .navbar { display: none !important; }
  .footer-wave, .footer { display: block !important; }
  .main-content {
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    min-height: auto !important;
    display: contents !important;
  }
  
  body {
    background: var(--bg-body) !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text-primary);
    padding: 0 !important;
    margin: 0 !important;
    min-height: 100vh;
  }
  
  .dashboard-container {
    background: var(--bg-dashboard);
    display: block;
    width: 100%;
    min-height: 100vh;
    margin: 0;
    padding: 24px;
    /* padding-left: 94px; - Removed to prevent double padding */
    border-radius: 0;
    box-shadow: none;
  }

  /* Left Sidebar - Use fixed from sidebar.ejs */
  .left-sidebar {
    position: fixed !important;
    left: 0 !important;
    top: 0 !important;
  }
  
  /* Hide old sidebar elements */
  .sidebar-header, .sidebar-brand, .profile-section, .profile-avatar-large, 
  .profile-title, .profile-subtitle, .nav-text, .subscription-indicator {
    display: none !important;
  }

  /* Main Content Area within Grid */
  .grid-main-content {
    min-width: 0;
    padding: 0 32px;
  }

  /* Page Header */
  .page-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 40px;
  }
  
  .page-header-icon {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, var(--blue-accent), var(--cyan-accent));
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }
  
  .page-header-content h1 {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 4px 0;
    letter-spacing: -0.5px;
  }
  
  .page-header-content p {
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Stats Cards - Clean & Simple */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }
  
  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px;
    transition: all 0.2s ease;
  }
  
  .stat-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }
  
  .stat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  
  .stat-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
  }
  
  .stat-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
  }
  
  .stat-value {
    font-size: 32px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
    margin-bottom: 8px;
  }
  
  .stat-subtitle {
    font-size: 12px;
    color: var(--text-secondary);
    font-weight: 500;
  }

  /* Charts Section */
  .charts-row {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
    margin-bottom: 32px;
  }
  
  .chart-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 24px;
  }
  
  .chart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }
  
  .chart-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
  }
  
  .chart-period {
    display: flex;
    gap: 8px;
  }
  
  .period-btn {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .period-btn.active {
    background: var(--blue-accent);
    color: #000;
    border-color: var(--blue-accent);
  }

  /* Bar Chart */
  .bar-chart {
    display: flex;
    align-items: flex-end;
    justify-content: space-around;
    height: 200px;
    padding: 10px 0;
    gap: 8px;
  }
  
  .bar-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    height: 100%;
    justify-content: flex-end;
  }
  
  .bar {
    width: 100%;
    min-height: 8px;
    background: linear-gradient(180deg, var(--cyan-accent), var(--blue-accent));
    border-radius: 8px 8px 0 0;
    position: relative;
    transition: all 0.3s ease;
    animation: barGrow 0.8s ease-out forwards;
    cursor: pointer;
  }
  
  .bar:hover {
    filter: brightness(1.2);
    box-shadow: 0 0 10px var(--cyan-accent);
  }
  
  @keyframes barGrow {
    from {
      transform: scaleY(0);
      transform-origin: bottom;
      opacity: 0;
    }
    to {
      transform: scaleY(1);
      transform-origin: bottom;
      opacity: 1;
    }
  }
  
  .bar-label {
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Donut Chart */
  .donut-chart-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  
  .donut-chart {
    position: relative;
    width: 180px;
    height: 180px;
  }
  
  .donut-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }
  
  .donut-total {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
  }
  
  .donut-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
  }
  
  .donut-legend {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }
  
  .legend-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .legend-color {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    margin-right: 8px;
  }
  
  .legend-name {
    flex: 1;
    font-size: 13px;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
  }
  
  .legend-value {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Repository Cards - Enhanced */
  .repo-cards-section {
    margin-bottom: 40px;
  }
  
  .section-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 20px;
    letter-spacing: -0.3px;
  }
  
  .repo-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }
  
  .repo-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 24px;
    transition: all 0.2s ease;
  }
  
  .repo-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }
  
  .repo-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-color);
  }
  
  .repo-name {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .repo-badge {
    padding: 4px 12px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    background: rgba(255, 215, 0, 0.15);
    color: var(--yellow-badge);
  }
  
  .repo-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 20px;
  }
  
  .repo-stat {
    text-align: center;
  }
  
  .repo-stat-value {
    font-size: 24px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
    margin-bottom: 6px;
  }
  
  .repo-stat-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .repo-fix-rate {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 16px;
  }
  
  .fix-rate-label {
    font-size: 12px;
    color: var(--text-secondary);
    font-weight: 500;
  }
  
  .fix-rate-value {
    font-size: 20px;
    font-weight: 700;
    color: var(--green-accent);
  }
  
  .repo-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .repo-time {
    font-size: 12px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Activity Table */
  .activity-section {
    margin-bottom: 32px;
  }
  
  .table-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }
  
  .table-tabs {
    display: flex;
    gap: 8px;
  }
  
  .tab-btn {
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .tab-btn.active {
    background: var(--blue-accent);
    color: #000;
    border-color: var(--blue-accent);
  }
  
  .table-search {
    display: flex;
    gap: 8px;
  }
  
  .search-input {
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
    font-size: 13px;
    min-width: 250px;
  }
  
  .search-input:focus {
    outline: none;
    border-color: var(--blue-accent);
  }

  .activity-table {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    overflow: hidden;
  }
  
  .activity-table table {
    width: 100%;
    border-collapse: collapse;
  }
  
  .activity-table thead {
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--border-color);
  }
  
  .activity-table th {
    padding: 16px;
    text-align: left;
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .activity-table td {
    padding: 16px;
    border-bottom: 1px solid var(--border-color);
    font-size: 13px;
    color: var(--text-secondary);
  }
  
  .activity-table tbody tr {
    transition: all 0.2s;
  }
  
  .activity-table tbody tr:hover {
    background: var(--bg-card-hover);
  }
  
  .activity-table tbody tr:last-child td {
    border-bottom: none;
  }
  
  .repo-cell {
    color: var(--text-primary);
    font-weight: 600;
    font-size: 14px;
  }
  
  /* Pagination */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    padding: 20px 0;
  }
  
  .pagination-btn {
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid var(--border-color);
    background: var(--bg-card);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s;
    min-width: 36px;
    text-align: center;
  }
  
  .pagination-btn:hover:not(.active):not(:disabled) {
    background: var(--bg-card-hover);
    border-color: rgba(255, 255, 255, 0.2);
  }
  
  .pagination-btn.active {
    background: var(--blue-accent);
    color: #000;
    border-color: var(--blue-accent);
    font-weight: 700;
  }
  
  .pagination-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  
  .pagination-info {
    font-size: 12px;
    color: var(--text-muted);
    margin: 0 12px;
  }
  
  .status-badge {
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
  }
  
  .status-completed {
    background: rgba(76, 217, 100, 0.15);
    color: var(--green-accent);
  }
  
  .status-failed {
    background: rgba(255, 95, 86, 0.15);
    color: var(--red-accent);
  }
  
  .status-running {
    background: rgba(10, 132, 255, 0.15);
    color: var(--blue-accent);
  }
  
  .circular-progress {
    width: 36px;
    height: 36px;
    position: relative;
    display: inline-block;
  }
  
  .circular-progress svg {
    transform: rotate(-90deg);
  }
  
  .progress-bg {
    fill: none;
    stroke: rgba(255, 255, 255, 0.1);
    stroke-width: 3;
  }
  
  .progress-fg {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    transition: stroke-dashoffset 0.5s ease;
  }
  
  .progress-fg.high {
    stroke: var(--green-accent);
  }
  
  .progress-fg.medium {
    stroke: var(--blue-accent);
  }
  
  .progress-fg.low {
    stroke: var(--red-accent);
  }
  
  .progress-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 10px;
    font-weight: 700;
    color: var(--text-primary);
  }
  
  .action-btn {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid var(--border-color);
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    display: inline-block;
  }
  
  .action-btn:hover {
    background: rgba(10, 132, 255, 0.15);
    border-color: var(--blue-accent);
    color: var(--blue-accent);
  }

  /* Empty State */
  .empty-state {
    background: var(--bg-card);
    border: 2px dashed var(--border-color);
    border-radius: 16px;
    padding: 60px 32px;
    text-align: center;
  }
  
  .empty-icon {
    font-size: 64px;
    opacity: 0.3;
    margin-bottom: 16px;
  }
  
  .empty-state h3 {
    font-size: 18px;
    color: var(--text-primary);
    margin-bottom: 8px;
  }
  
  .empty-state p {
    color: var(--text-muted);
    font-size: 13px;
  }
</style>

<div class="dashboard-container">
  <%- include('partials/sidebar', { activePage: 'audits' }) %>
  
  <main class="grid-main-content">
    <!-- Page Header -->
    <div class="page-header">
      <div class="page-header-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
        </svg>
      </div>
      <div class="page-header-content">
        <h1>Audit Analytics</h1>
        <p>Comprehensive overview of PR analysis runs, issues, and performance metrics</p>
      </div>
    </div>

    <%
      const totalAudits = audits.length;
      const completedAudits = audits.filter(a => a.status === 'completed').length;
      const failedAudits = audits.filter(a => a.status === 'failed').length;
      const runningAudits = audits.filter(a => a.status === 'running').length;
      const totalIssuesFound = audits.reduce((sum, a) => sum + (a.findings?.length || 0), 0);
      const totalFixed = audits.reduce((sum, a) => sum + (a.findings?.filter(f => f.fixed).length || 0), 0);
      const fixRate = totalIssuesFound > 0 ? Math.round((totalFixed / totalIssuesFound) * 100) : 0;
      
      // Calculate trends (mock data - you can enhance this)
      const successRate = totalAudits > 0 ? Math.round((completedAudits / totalAudits) * 100) : 0;
      
      // Severity breakdown
      const severityCounts = {
        critical: 0,
        high: 0,
        medium: 0,
        low: 0
      };
      audits.forEach(audit => {
        (audit.findings || []).forEach(f => {
          if (severityCounts[f.severity] !== undefined) {
            severityCounts[f.severity]++;
          }
        });
      });
      
      // Group by repository
      const repoGroups = {};
      audits.forEach(audit => {
        if (!repoGroups[audit.repo]) {
          repoGroups[audit.repo] = {
            name: audit.repo,
            totalPRs: 0,
            issues: 0,
            fixed: 0,
            lastActivity: audit.createdAt
          };
        }
        repoGroups[audit.repo].totalPRs++;
        repoGroups[audit.repo].issues += (audit.findings?.length || 0);
        repoGroups[audit.repo].fixed += (audit.findings?.filter(f => f.fixed).length || 0);
        if (new Date(audit.createdAt) > new Date(repoGroups[audit.repo].lastActivity)) {
          repoGroups[audit.repo].lastActivity = audit.createdAt;
        }
      });
      const repoList = Object.values(repoGroups);
    %>

    <!-- Stats Cards -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-header">
          <div class="stat-label">Total Runs</div>
          <div class="stat-icon" style="color: var(--blue-accent);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
        </div>
        <div class="stat-value"><%= totalAudits %></div>
        <div class="stat-subtitle">All PR analyses</div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <div class="stat-label">Completed</div>
          <div class="stat-icon" style="color: var(--green-accent);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
        </div>
        <div class="stat-value"><%= completedAudits %></div>
        <div class="stat-subtitle"><%= successRate %>% success rate</div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <div class="stat-label">Failed</div>
          <div class="stat-icon" style="color: var(--red-accent);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </div>
        </div>
        <div class="stat-value"><%= failedAudits %></div>
        <div class="stat-subtitle"><% if (failedAudits === 0) { %>No failures<% } else { %><%= Math.floor((failedAudits / totalAudits) * 100) %>% of total<% } %></div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <div class="stat-label">Issues Found</div>
          <div class="stat-icon" style="color: var(--orange-accent);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
        </div>
        <div class="stat-value"><%= totalIssuesFound %></div>
        <div class="stat-subtitle"><%= totalFixed %> fixed</div>
      </div>

      <div class="stat-card">
        <div class="stat-header">
          <div class="stat-label">Fix Rate</div>
          <div class="stat-icon" style="color: var(--green-accent);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
        </div>
        <div class="stat-value" style="<%= fixRate >= 90 ? 'color: var(--green-accent); text-shadow: 0 0 20px rgba(76, 217, 100, 0.4);' : fixRate >= 70 ? 'color: var(--blue-accent);' : 'color: var(--text-primary);' %>"><%= fixRate %>%</div>
        <div class="stat-subtitle"><%= fixRate >= 90 ? 'Excellent' : fixRate >= 75 ? 'Good' : fixRate >= 50 ? 'Average' : 'Needs Improvement' %> performance</div>
      </div>
    </div>

    <!-- Charts Row -->
    <div class="charts-row">
      <!-- Bar Chart: Activity Over Time -->
      <div class="chart-card">
        <div class="chart-header">
          <h3 class="chart-title">Activity Over Time</h3>
          <div class="chart-period">
            <button class="period-btn active">7D</button>
            <button class="period-btn">30D</button>
          </div>
        </div>
        <div class="bar-chart">
          <% 
            const activityData = typeof dailyActivity !== 'undefined' ? dailyActivity : [];
            const maxCount = Math.max(1, ...activityData.map(d => d.count));
            activityData.forEach((day, i) => {
              const percentage = day.count > 0 ? (day.count / maxCount) * 100 : 5;
          %>
            <div class="bar-item">
              <div class="bar" style="height: <%= Math.max(8, percentage) %>%; animation-delay: <%= i * 0.1 %>s;" title="<%= day.count %> audits on <%= day.label %>"></div>
              <div class="bar-label"><%= day.label %></div>
            </div>
          <% }); %>
        </div>

      </div>

      <!-- Donut Chart: Severity Breakdown -->
      <div class="chart-card">
        <div class="chart-header">
          <h3 class="chart-title">Issue Severity</h3>
        </div>
        <div class="donut-chart-container">
          <div class="donut-chart">
            <svg viewBox="0 0 100 100">
              <% 
                const total = severityCounts.critical + severityCounts.high + severityCounts.medium + severityCounts.low || 1;
                let currentAngle = 0;
                const colors = {
                  critical: '#FF5F56',
                  high: '#FFD700',
                  medium: '#0A84FF',
                  low: '#9CA3AF'
                };
                Object.keys(severityCounts).forEach(severity => {
                  const count = severityCounts[severity];
                  const percentage = (count / total);
                  const angle = percentage * 360;
                  const endAngle = currentAngle + angle;
                  
                  const startX = 50 + 35 * Math.cos((currentAngle - 90) * Math.PI / 180);
                  const startY = 50 + 35 * Math.sin((currentAngle - 90) * Math.PI / 180);
                  const endX = 50 + 35 * Math.cos((endAngle - 90) * Math.PI / 180);
                  const endY = 50 + 35 * Math.sin((endAngle - 90) * Math.PI / 180);
                  const largeArc = angle > 180 ? 1 : 0;
                  
                  if (count > 0) {
              %>
                <path d="M 50 50 L <%= startX %> <%= startY %> A 35 35 0 <%= largeArc %> 1 <%= endX %> <%= endY %> Z" 
                      fill="<%= colors[severity] %>" opacity="0.8" />
              <% 
                  }
                  currentAngle = endAngle;
                });
              %>
              <circle cx="50" cy="50" r="22" fill="var(--bg-card)" />
            </svg>
            <div class="donut-center">
              <div class="donut-total"><%= total %></div>
              <div class="donut-label">Total</div>
            </div>
          </div>
          <div class="donut-legend">
            <div class="legend-item">
              <div class="legend-name">
                <div class="legend-color" style="background: #FF5F56;"></div>
                Critical
              </div>
              <div class="legend-value"><%= severityCounts.critical %></div>
            </div>
            <div class="legend-item">
              <div class="legend-name">
                <div class="legend-color" style="background: #FFD700;"></div>
                High
              </div>
              <div class="legend-value"><%= severityCounts.high %></div>
            </div>
            <div class="legend-item">
              <div class="legend-name">
                <div class="legend-color" style="background: #0A84FF;"></div>
                Medium
              </div>
              <div class="legend-value"><%= severityCounts.medium %></div>
            </div>
            <div class="legend-item">
              <div class="legend-name">
                <div class="legend-color" style="background: #9CA3AF;"></div>
                Low
              </div>
              <div class="legend-value"><%= severityCounts.low %></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Repository Performance Cards -->
    <% if (repoList.length > 0) { %>
    <div class="repo-cards-section">
      <h2 class="section-title">Repository Performance</h2>
      <div class="repo-cards-grid">
        <% repoList.slice(0, 6).forEach(repo => { 
          const repoFixRate = repo.issues > 0 ? Math.round((repo.fixed / repo.issues) * 100) : 0;
        %>
        <div class="repo-card">
          <div class="repo-header">
            <div class="repo-name">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
              </svg>
              <%= repo.name.split('/').pop() %>
            </div>
            <div class="repo-badge"><%= repo.totalPRs %> PRs</div>
          </div>
          <div class="repo-stats">
            <div class="repo-stat">
              <div class="repo-stat-value"><%= repo.totalPRs %></div>
              <div class="repo-stat-label">Total PRs</div>
            </div>
            <div class="repo-stat">
              <div class="repo-stat-value"><%= repo.issues %></div>
              <div class="repo-stat-label">Issues</div>
            </div>
            <div class="repo-stat">
              <div class="repo-stat-value"><%= repo.fixed %></div>
              <div class="repo-stat-label">Fixed</div>
            </div>
          </div>
          <div class="repo-fix-rate">
            <span class="fix-rate-label">Fix Rate</span>
            <span class="fix-rate-value"><%= repoFixRate %>%</span>
          </div>
          <div class="repo-footer">
            <span class="repo-time">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <%= new Date(repo.lastActivity).toLocaleDateString() %>
            </span>
            <a href="/repo/<%= repo.name %>" class="action-btn">View Details </a>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
    <% } %>

    <!-- Recent Activity Table -->
    <div class="activity-section">
      <h2 class="section-title">Recent Audit Activity</h2>
      <div class="table-controls">
        <div class="table-tabs">
          <button class="tab-btn active" onclick="filterStatus('')">All</button>
          <button class="tab-btn" onclick="filterStatus('completed')">Completed</button>
          <button class="tab-btn" onclick="filterStatus('failed')">Failed</button>
          <button class="tab-btn" onclick="filterStatus('running')">Running</button>
        </div>
        <div class="table-search">
          <input type="text" class="search-input" placeholder="Search repository..." id="searchInput" onkeyup="searchTable()" />
        </div>
      </div>

      <% if (audits && audits.length > 0) { %>
      <div class="activity-table">
        <table id="auditTable">
          <thead>
            <tr>
              <th>Repository</th>
              <th>PR #</th>
              <th>Status</th>
              <th>Issues</th>
              <th>Fixed</th>
              <th>Fix Rate</th>
              <th>Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% audits.slice(0, 50).forEach((audit, index) => { 
              const findings = audit.findings || [];
              const fixedCount = findings.filter(f => f.fixed).length;
              const auditFixRate = findings.length > 0 ? Math.round((fixedCount / findings.length) * 100) : 0;
              const progressColor = auditFixRate >= 75 ? 'high' : auditFixRate >= 50 ? 'medium' : 'low';
              const circumference = 2 * Math.PI * 16;
              const offset = circumference - (auditFixRate / 100) * circumference;
            %>
            <tr data-status="<%= audit.status %>" data-repo="<%= audit.repo %>" data-index="<%= index %>" class="audit-row" style="display: <%= index < 10 ? '' : 'none' %>;">
              <td class="repo-cell"><%= audit.repo %></td>
              <td>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" style="opacity: 0.7; margin-right: 4px; vertical-align: middle;"><path d="M5 3.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0zm0 2.122a2.25 2.25 0 1 0-1.5 0v.878A2.25 2.25 0 0 0 5.75 8.5h1.5v2.128a2.251 2.251 0 1 0 1.5 0V8.5h1.5a2.25 2.25 0 0 0 2.25-2.25v-.878a2.25 2.25 0 1 0-1.5 0v.878a.75.75 0 0 1-.75.75h-4.5A.75.75 0 0 1 5 6.25v-.878zm3.75 7.378a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0zm3-8.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5z"/></svg>#<%= audit.prNumber %>
              </td>
              <td>
                <span class="status-badge status-<%= audit.status %>">
                  <%= audit.status %>
                </span>
              </td>
              <td><%= findings.length %></td>
              <td><%= fixedCount %></td>
              <td>
                <div class="circular-progress">
                  <svg width="36" height="36" viewBox="0 0 36 36">
                    <circle class="progress-bg" cx="18" cy="18" r="16"></circle>
                    <circle class="progress-fg <%= progressColor %>" cx="18" cy="18" r="16"
                      stroke-dasharray="<%= circumference %>"
                      stroke-dashoffset="<%= offset %>"></circle>
                  </svg>
                  <div class="progress-text"><%= auditFixRate %>%</div>
                </div>
              </td>
              <td><%= new Date(audit.createdAt).toLocaleDateString() %></td>
              <td>
                <a href="/runs/<%= audit._id %>/select" class="action-btn">View</a>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      
      <!-- Pagination -->
      <div class="pagination" id="pagination">
        <button class="pagination-btn" onclick="changePage('prev')" id="prevBtn">←</button>
        <div id="pageButtons"></div>
        <button class="pagination-btn" onclick="changePage('next')" id="nextBtn">→</button>
      </div>
      <% } else { %>
      <div class="empty-state">
        <div class="empty-icon">📊</div>
        <h3>No Audit Logs Yet</h3>
        <p>Start analyzing pull requests to see audit data here</p>
      </div>
      <% } %>
    </div>
  </main>
</div>

<script>
  // State management
  let currentPage = 1;
  const itemsPerPage = 10;
  let currentStatusFilter = '';
  let currentSearchQuery = '';
  
  // Get all rows that match current filters
  function getFilteredRows() {
    const allRows = Array.from(document.querySelectorAll('#auditTable tbody tr.audit-row'));
    return allRows.filter(row => {
      const matchesStatus = !currentStatusFilter || row.dataset.status === currentStatusFilter;
      const matchesSearch = !currentSearchQuery || row.dataset.repo.toLowerCase().includes(currentSearchQuery);
      return matchesStatus && matchesSearch;
    });
  }
  
  // Update pagination based on filtered rows
  function updatePagination() {
    const filteredRows = getFilteredRows();
    const totalPages = Math.max(1, Math.ceil(filteredRows.length / itemsPerPage));
    
    // Ensure current page is valid
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;
    
    const start = (currentPage - 1) * itemsPerPage;
    const end = start + itemsPerPage;
    
    // First hide all rows
    document.querySelectorAll('#auditTable tbody tr.audit-row').forEach(row => {
      row.style.display = 'none';
    });
    
    // Show only the filtered rows for current page
    filteredRows.forEach((row, idx) => {
      row.style.display = (idx >= start && idx < end) ? '' : 'none';
    });
    
    // Update pagination buttons
    renderPageButtons(totalPages);
    
    // Update prev/next buttons
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    if (prevBtn) prevBtn.disabled = currentPage === 1;
    if (nextBtn) nextBtn.disabled = currentPage === totalPages;
  }
  
  function renderPageButtons(totalPages) {
    const pageButtonsContainer = document.getElementById('pageButtons');
    if (!pageButtonsContainer) return;
    pageButtonsContainer.innerHTML = '';
    
    // Limit displayed pages for better UX
    const maxButtons = 5;
    let startPage = Math.max(1, currentPage - Math.floor(maxButtons / 2));
    let endPage = Math.min(totalPages, startPage + maxButtons - 1);
    if (endPage - startPage < maxButtons - 1) {
      startPage = Math.max(1, endPage - maxButtons + 1);
    }
    
    for (let i = startPage; i <= endPage; i++) {
      const btn = document.createElement('button');
      btn.className = 'pagination-btn' + (i === currentPage ? ' active' : '');
      btn.textContent = i;
      btn.onclick = () => goToPage(i);
      pageButtonsContainer.appendChild(btn);
    }
  }
  
  function goToPage(page) {
    currentPage = page;
    updatePagination();
  }
  
  function changePage(direction) {
    const filteredRows = getFilteredRows();
    const totalPages = Math.max(1, Math.ceil(filteredRows.length / itemsPerPage));
    
    if (direction === 'prev' && currentPage > 1) {
      currentPage--;
    } else if (direction === 'next' && currentPage < totalPages) {
      currentPage++;
    }
    updatePagination();
  }
  
  function filterStatus(status) {
    // Update active tab
    const tabs = document.querySelectorAll('.tab-btn');
    tabs.forEach(tab => tab.classList.remove('active'));
    event.target.classList.add('active');
    
    // Update filter state
    currentStatusFilter = status;
    currentPage = 1;
    updatePagination();
  }
  
  function searchTable() {
    const input = document.getElementById('searchInput');
    currentSearchQuery = input ? input.value.toLowerCase() : '';
    currentPage = 1;
    updatePagination();
  }
  
  // Initialize on page load
  window.addEventListener('DOMContentLoaded', () => {
    updatePagination();
  });
</script>
