<% layout('layout') %>

<!-- Highlight.js for syntax highlighting -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/vs2015.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

<style>
  :root {
    --bg-body: #121212;
    --bg-card: #1A1A1A;
    --border-color: #2A2A2A;
    --text-primary: #FFFFFF;
    --text-secondary: #9CA3AF;
    --text-muted: #6B7280;
    --green-accent: #4CD964;
    --red-accent: #FF5F56;
    --yellow-accent: #FFD700;
    --blue-accent: #0A84FF;
    --orange-accent: #FF9500;
  }

  .navbar { display: none !important; }
  .footer-wave, .footer { display: block !important; }
  .main-content {
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    min-height: auto !important;
    display: contents !important;
  }
  
  body {
    background: var(--bg-body) !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text-primary);
    padding: 0 !important;
    margin: 0 !important;
    min-height: 100vh;
  }

  .preview-container {
    display: block;
    min-height: 100vh;
    padding: 24px;
    padding: 24px;
    /* padding-left: 94px; - Removed */
  }

  /* Sidebar - use fixed from sidebar.ejs */
  .preview-container .left-sidebar {
    position: fixed !important;
    left: 0 !important;
    top: 0 !important;
  }
  /* Hide old sidebar elements */
  .preview-container .left-sidebar .sidebar-brand,
  .preview-container .left-sidebar .profile-section,
  .preview-container .left-sidebar .nav-text,
  .preview-container .left-sidebar .subscription-indicator,
  .sidebar-header, .profile-avatar-large, .profile-title, .profile-subtitle {
    display: none !important;
  }

  /* Main Content */
  .preview-main {
    padding: 0 24px;
    overflow-y: auto;
    max-height: calc(100vh - 48px);
  }

  /* Page Header */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .page-title {
    font-size: 22px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .breadcrumb {
    font-size: 12px;
    color: var(--text-muted);
    margin-top: 4px;
  }
  .header-actions {
    display: flex;
    gap: 12px;
  }

  /* Step Tracker Mini */
  .step-tracker-mini {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    padding: 10px 14px;
    background: var(--bg-card);
    border-radius: 8px;
    border: 1px solid var(--border-color);
  }
  .step-mini {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 16px;
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.03);
  }
  .step-mini.completed { background: rgba(76, 217, 100, 0.15); color: var(--green-accent); }
  .step-mini.active { background: rgba(10, 132, 255, 0.15); color: var(--blue-accent); }
  .step-mini .step-num {
    width: 18px; height: 18px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    display: flex; align-items: center; justify-content: center;
    font-size: 9px; font-weight: 700;
  }
  .step-mini.completed .step-num { background: var(--green-accent); color: #000; }
  .step-mini.active .step-num { background: var(--blue-accent); color: #fff; }

  /* Preview Content Grid */
  .preview-grid {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 20px;
    margin-bottom: 20px;
    transition: grid-template-columns 0.3s ease;
  }
  .preview-grid.sidebar-collapsed {
    grid-template-columns: 48px minmax(0, 1fr);
  }

  /* Files Panel */
  .files-panel {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
  }
  .sidebar-collapsed .files-panel .panel-header-text,
  .sidebar-collapsed .files-panel .file-name,
  .sidebar-collapsed .files-panel .file-status,
  .sidebar-collapsed .files-panel .action-bar {
    display: none;
  }
  .sidebar-collapsed .files-panel .panel-header {
    padding: 14px 12px;
    justify-content: center;
  }
  .sidebar-collapsed .files-panel .file-item {
    justify-content: center;
    padding: 12px 10px;
  }
  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .sidebar-toggle {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    cursor: pointer;
    padding: 6px 8px;
    border-radius: 6px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 500;
  }
  .sidebar-toggle:hover {
    background: rgba(255, 255, 255, 0.15);
    color: var(--text-primary);
    border-color: var(--blue-accent);
  }
  .sidebar-toggle svg {
    transition: transform 0.3s ease;
  }
  .sidebar-collapsed .sidebar-toggle svg {
    transform: rotate(180deg);
  }
  .sidebar-collapsed .sidebar-toggle .toggle-text {
    display: none;
  }
  .panel-header {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border-color);
    font-weight: 600;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .files-list {
    max-height: 400px;
    overflow-y: auto;
  }
  .file-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-color);
    cursor: pointer;
    transition: background 0.2s;
  }
  .file-item:hover { background: rgba(255, 255, 255, 0.03); }
  .file-item.active { background: rgba(10, 132, 255, 0.1); border-left: 3px solid var(--blue-accent); }
  .file-item:last-child { border-bottom: none; }
  .file-icon { color: var(--text-muted); flex-shrink: 0; }
  .file-name {
    flex: 1;
    font-size: 12px;
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .file-status {
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
  }
  .file-status.done { background: rgba(76, 217, 100, 0.2); color: var(--green-accent); }
  .file-status.pending { background: rgba(255, 149, 0, 0.2); color: var(--orange-accent); }
  .file-status.processing { background: rgba(10, 132, 255, 0.2); color: var(--blue-accent); }

  /* Code Preview Panel - Side by Side Diff */
  .code-panel {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow-x: auto;
    overflow-y: auto;
    max-height: 600px;
  }
  .code-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-color);
    background: rgba(0, 0, 0, 0.2);
  }
  .code-filename {
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 13px;
    color: var(--blue-accent);
  }
  
  /* Side by side diff table */
  .diff-table {
    width: 100%;
    min-width: max-content;
    table-layout: auto;
    border-collapse: collapse;
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 12px;
  }
  .diff-table th {
    background: rgba(0, 0, 0, 0.3);
    padding: 10px 16px;
    text-align: left;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-color);
  }
  .diff-table th.original { color: #FF6B6B; }
  .diff-table th.improved { color: #7EE787; }
  .diff-table td {
    vertical-align: top;
    padding: 0;
    min-width: 400px;
    width: 50%;
    border-right: 1px solid var(--border-color);
  }
  .diff-table td:last-child { border-right: none; }
  
  .diff-content {
    max-height: 500px;
    overflow-y: auto;
    overflow-x: visible;
    min-width: 100%;
  }
  
  .diff-line {
    display: flex;
    min-height: 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
  }
  .diff-line-num {
    width: 40px;
    min-width: 40px;
    padding: 2px 8px;
    text-align: right;
    color: var(--text-muted);
    background: rgba(0, 0, 0, 0.2);
    user-select: none;
    font-size: 11px;
  }
  .diff-line-content {
    flex: 1;
    padding: 2px 12px;
    white-space: pre-wrap;
    word-break: break-all;
    overflow-wrap: break-word;
    min-width: 0;
  }
  
  /* Removed lines (left side - original) */
  .diff-line.removed {
    background: rgba(255, 95, 86, 0.12);
  }
  .diff-line.removed .diff-line-num {
    background: rgba(255, 95, 86, 0.2);
    color: #FF6B6B;
  }
  .diff-line.removed .diff-line-content {
    color: #FF6B6B;
  }
  
  /* Added lines (right side - new) */
  .diff-line.added {
    background: rgba(76, 217, 100, 0.12);
  }
  .diff-line.added .diff-line-num {
    background: rgba(76, 217, 100, 0.2);
    color: #7EE787;
  }
  .diff-line.added .diff-line-content {
    color: #7EE787;
  }
  
  /* Changed lines */
  .diff-line.changed-old {
    background: rgba(255, 95, 86, 0.12);
  }
  .diff-line.changed-old .diff-line-num {
    background: rgba(255, 95, 86, 0.2);
    color: #FF6B6B;
  }
  .diff-line.changed-old .diff-line-content {
    color: #FF6B6B;
  }
  
  .diff-line.changed-new {
    background: rgba(76, 217, 100, 0.12);
  }
  .diff-line.changed-new .diff-line-num {
    background: rgba(76, 217, 100, 0.2);
    color: #7EE787;
  }
  .diff-line.changed-new .diff-line-content {
    color: #7EE787;
  }
  
  /* Unchanged lines */
  .diff-line.unchanged .diff-line-content {
    color: var(--text-secondary);
  }

  /* Action Buttons */
  .action-bar {
    display: flex;
    justify-content: center;
    gap: 12px;
    padding: 16px;
    border-top: 1px solid var(--border-color);
    background: rgba(0, 0, 0, 0.2);
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }
  .btn-primary {
    background: var(--green-accent);
    color: #000;
  }
  .btn-primary:hover { background: #5FE574; }
  .btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }
  .btn-secondary:hover { background: rgba(255, 255, 255, 0.12); }

  /* Patch Status Section */
  .status-section {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px;
  }
  .status-header {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .status-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .status-card {
    background: rgba(0, 0, 0, 0.2);
    border-radius: 10px;
    padding: 16px;
  }
  .status-card-title {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .status-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    font-size: 13px;
  }
  .status-icon { font-size: 18px; }
  .status-icon.success { color: var(--green-accent); }
  .status-icon.error { color: var(--red-accent); }
  .status-icon.pending { color: var(--orange-accent); }

  .commit-hash {
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 12px;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    padding: 4px 8px;
    border-radius: 4px;
  }

  .btn-open-pr {
    background: var(--green-accent);
    color: #000;
    padding: 10px 20px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    margin-top: 12px;
  }

  /* Loading state */
  .loading-spinner {
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 2px solid var(--text-muted);
    border-radius: 50%;
    border-top-color: var(--blue-accent);
    animation: spin 1s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<div class="preview-container">
  <%- include('partials/sidebar', { activePage: 'repos' }) %>
  
  <main class="preview-main">
    <!-- Page Header -->
    <div class="page-header">
      <div>
        <div class="page-title">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
          </svg>
          Preview Fixes
        </div>
        <div class="breadcrumb">/runs/<%= runId %>/preview</div>
      </div>
      <div class="header-actions">
        <a href="/runs/<%= runId %>/select" class="btn btn-secondary">Back to Selection</a>
      </div>
    </div>

    <!-- Step Tracker Mini -->
    <div class="step-tracker-mini">
      <div class="step-mini completed"><span class="step-num">✓</span><span>PR Detected</span></div>
      <div class="step-mini completed"><span class="step-num">✓</span><span>Analysis Done</span></div>
      <div class="step-mini completed"><span class="step-num">✓</span><span>Select Issues</span></div>
      <div class="step-mini active"><span class="step-num">4</span><span>Preview Fixes</span></div>
      <div class="step-mini"><span class="step-num">5</span><span>Apply & Merge</span></div>
    </div>

    <% if (!(patch.status === 'preview_ready' || patch.status === 'preview_partial')) { %>
      <div class="status-section" id="building-status">
        <div class="status-header">
          <span class="loading-spinner"></span>
          Building Preview...
        </div>
        <p style="color: var(--text-muted); margin-bottom: 16px;">Preview is not ready yet. Checking status...</p>
        <a href="/runs/<%= runId %>/preview?patchRequestId=<%= patchRequestId %>" class="btn btn-secondary">Refresh Now</a>
      </div>
      <script>
        (function(){
          const runId = '<%= runId %>';
          const patchRequestId = '<%= patchRequestId %>';
          async function checkStatus() {
            try {
              const r = await fetch(`/runs/${runId}/patches/${patchRequestId}/status`);
              if (r.ok) {
                const data = await r.json();
                if (data.status === 'preview_ready' || data.status === 'preview_partial') {
                  window.location.reload();
                  return;
                }
              }
            } catch(e) {}
            setTimeout(checkStatus, 5000);
          }
          setTimeout(checkStatus, 5000);
        })();
      </script>
    <% } else { %>
      <!-- Preview Content -->
      <div class="preview-grid">
        <!-- Files Panel -->
        <div class="files-panel">
          <div class="panel-header">
            <span class="panel-header-text">Preview Fixes</span>
            <button class="sidebar-toggle" id="sidebar-toggle" title="Hide/Show files">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="9" y1="3" x2="9" y2="21"></line>
              </svg>
              <span class="toggle-text">Hide</span>
            </button>
          </div>
          <div class="files-list" id="files-list">
            <!-- Files will be populated by JS -->
          </div>
          <div class="action-bar">
            <form method="post" action="/runs/<%= runId %>/patches/apply" id="apply-form">
              <input type="hidden" name="patchRequestId" value="<%= patchRequestId %>">
              <button type="submit" class="btn btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Apply Fixes
              </button>
            </form>
            <a href="/runs/<%= runId %>/select" class="btn btn-secondary">Cancel</a>
          </div>
        </div>

        <!-- Code Panel - Side by Side Diff -->
        <div class="code-panel">
          <div class="code-header">
            <span class="code-filename" id="code-filename">Select a file to preview</span>
            <span id="file-status" class="file-status pending">Loading</span>
          </div>
          <table class="diff-table">
            <thead>
              <tr>
                <th class="original">📄 Original</th>
                <th class="improved">✨ Improved</th>
              </tr>
            </thead>
            <tbody id="diff-body">
              <tr>
                <td colspan="2" style="padding: 40px; text-align: center; color: var(--text-muted);">
                  Select a file from the list to see the code changes.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <% if (patch.status === 'preview_partial') { %>
        <div id="partial-status" style="padding: 12px 16px; background: rgba(255, 149, 0, 0.1); border: 1px solid rgba(255, 149, 0, 0.3); border-radius: 8px; color: var(--orange-accent); margin-bottom: 16px;">
          ⏳ Building preview... Some files may still be processing.
        </div>
        <script>
          (function(){
            const runId = '<%= runId %>';
            const patchRequestId = '<%= patchRequestId %>';
            let lastFileCount = 0;
            async function checkPartialStatus() {
              try {
                const r = await fetch(`/runs/${runId}/patches/${patchRequestId}/files`);
                if (r.ok) {
                  const data = await r.json();
                  const readyCount = (data.files || []).filter(f => f.ready).length;
                  const total = data.files ? data.files.length : 0;
                  if (readyCount > lastFileCount) {
                    lastFileCount = readyCount;
                    document.getElementById('partial-status').innerHTML = 
                      `⏳ Building preview... ${readyCount}/${total} files ready.`;
                  }
                  if (readyCount === total && total > 0) {
                    document.getElementById('partial-status').style.display = 'none';
                    return;
                  }
                }
              } catch(e) {}
              setTimeout(checkPartialStatus, 5000);
            }
            setTimeout(checkPartialStatus, 5000);
          })();
        </script>
      <% } %>

      <!-- Patch Status Section -->
      <div class="status-section">
        <div class="status-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          Patch Status
          <span style="font-size: 12px; color: var(--text-muted); font-weight: 400; margin-left: 8px;">/runs/<%= runId %>/patches/<%= patchRequestId %></span>
        </div>
        
        <div class="status-grid">
          <div class="status-card">
            <div class="status-card-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
              Status
            </div>
            <div class="status-item">
              <span class="status-icon success">✓</span>
              <span>Ready for review</span>
            </div>
            <div id="files-summary" style="font-size: 12px; color: var(--text-muted); margin-top: 8px;"></div>
          </div>
          
          <div class="status-card">
            <div class="status-card-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"></circle><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"></path></svg>
              Commit Info
            </div>
            <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 6px;">Patch Request ID</div>
            <div class="commit-hash"><%= patchRequestId %></div>
          </div>
        </div>
      </div>

      <script>
        (async function(){
          const runId = '<%= runId %>';
          const patchRequestId = '<%= patchRequestId %>';
          const filesList = document.getElementById('files-list');
          const codeFilename = document.getElementById('code-filename');
          const fileStatus = document.getElementById('file-status');
          const filesSummary = document.getElementById('files-summary');

          function escapeHtml(s){
            return String(s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
          }

          // Get language from file extension for syntax highlighting
          function getLanguage(filename) {
            const ext = filename.split('.').pop().toLowerCase();
            const langMap = {
              'js': 'javascript', 'jsx': 'javascript', 'ts': 'typescript', 'tsx': 'typescript',
              'py': 'python', 'java': 'java', 'go': 'go', 'rb': 'ruby', 'rs': 'rust',
              'c': 'c', 'cpp': 'cpp', 'h': 'cpp', 'cs': 'csharp', 'php': 'php',
              'html': 'html', 'htm': 'html', 'css': 'css', 'scss': 'scss', 'sass': 'scss',
              'json': 'json', 'xml': 'xml', 'yaml': 'yaml', 'yml': 'yaml',
              'md': 'markdown', 'sql': 'sql', 'sh': 'bash', 'bash': 'bash',
              'dockerfile': 'dockerfile', 'kt': 'kotlin', 'swift': 'swift'
            };
            return langMap[ext] || 'plaintext';
          }

          // Apply syntax highlighting to code text
          function highlightCode(code, lang) {
            try {
              if (hljs.getLanguage(lang)) {
                return hljs.highlight(code, { language: lang }).value;
              }
              return hljs.highlightAuto(code).value;
            } catch (e) {
              return escapeHtml(code);
            }
          }

          async function fetchFiles(){
            const r = await fetch(`/runs/${runId}/patches/${patchRequestId}/files`);
            if (!r.ok) return { files: [], expected: 0 };
            return r.json();
          }

          async function fetchFile(file, doProcess){
            const url = `/runs/${runId}/patches/${patchRequestId}/file?file=${encodeURIComponent(file)}${doProcess?'&process=1':''}`;
            const r = await fetch(url);
            if (!r.ok) return { ready:false };
            return r.json();
          }

          function renderFilesList(files) {
            filesList.innerHTML = files.map((f, i) => `
              <div class="file-item ${i === 0 ? 'active' : ''}" data-file="${escapeHtml(f.file)}" data-index="${i}">
                <svg class="file-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                </svg>
                <span class="file-name">${escapeHtml(f.file.split('/').pop())}</span>
                <span class="file-status ${f.ready ? 'done' : 'pending'}">${f.ready ? 'Done' : 'Pending'}</span>
              </div>
            `).join('');

            document.querySelectorAll('.file-item').forEach(item => {
              item.addEventListener('click', () => {
                document.querySelectorAll('.file-item').forEach(el => el.classList.remove('active'));
                item.classList.add('active');
                loadFile(item.dataset.file);
              });
            });
          }

          async function loadFile(filename) {
            const diffBody = document.getElementById('diff-body');
            codeFilename.textContent = filename;
            fileStatus.textContent = 'Loading';
            fileStatus.className = 'file-status processing';
            diffBody.innerHTML = '<tr><td colspan="2" style="padding: 40px; text-align: center; color: var(--text-muted);"><span class="loading-spinner"></span> Loading...</td></tr>';

            let data = await fetchFile(filename, true);
            const start = Date.now();
            while (!data.ready && (Date.now()-start) < 30000){
              await new Promise(r=>setTimeout(r, 2000));
              data = await fetchFile(filename, false);
            }

            if (!data.ready) {
              diffBody.innerHTML = '<tr><td colspan="2" style="padding: 40px; text-align: center; color: var(--orange-accent);">Still processing...</td></tr>';
              fileStatus.textContent = 'Processing';
              return;
            }

            fileStatus.textContent = 'Done';
            fileStatus.className = 'file-status done';

            const lang = getLanguage(filename);
            const left = String(data.originalText||'').split(/\r?\n/);
            const right = String(data.improvedText||'').split(/\r?\n/);
            const maxLen = Math.max(left.length, right.length);

            // Pre-highlight entire code blocks for better syntax coloring
            const leftHighlighted = highlightCode(data.originalText || '', lang).split(/\r?\n/);
            const rightHighlighted = highlightCode(data.improvedText || '', lang).split(/\r?\n/);

            // Build side-by-side diff HTML
            let leftHtml = '';
            let rightHtml = '';
            
            for (let j=0; j<maxLen; j++){
              const l = left[j] !== undefined ? left[j] : '';
              const r = right[j] !== undefined ? right[j] : '';
              const lHighlighted = leftHighlighted[j] || '';
              const rHighlighted = rightHighlighted[j] || '';
              const isDifferent = l !== r;
              
              // Left side (original)
              const leftClass = isDifferent ? (l ? 'changed-old' : 'removed') : 'unchanged';
              leftHtml += `<div class="diff-line ${leftClass}">
                <span class="diff-line-num">${l !== '' || !isDifferent ? j+1 : ''}</span>
                <span class="diff-line-content">${lHighlighted}</span>
              </div>`;
              
              // Right side (improved)
              const rightClass = isDifferent ? (r ? 'changed-new' : 'added') : 'unchanged';
              rightHtml += `<div class="diff-line ${rightClass}">
                <span class="diff-line-num">${r !== '' || !isDifferent ? j+1 : ''}</span>
                <span class="diff-line-content">${rHighlighted}</span>
              </div>`;
            }
            
            diffBody.innerHTML = `<tr>
              <td><div class="diff-content">${leftHtml}</div></td>
              <td><div class="diff-content">${rightHtml}</div></td>
            </tr>`;
          }

          // Initialize
          const meta = await fetchFiles();
          const files = meta.files || [];
          filesSummary.textContent = `${files.length} files · ${files.filter(f=>f.ready).length} ready`;

          if (files.length > 0) {
            renderFilesList(files);
            loadFile(files[0].file);
          } else {
            codeContent.innerHTML = '<div style="padding: 40px; text-align: center; color: var(--text-muted);">No files to preview.</div>';
          }

          // Sidebar toggle functionality
          const sidebarToggle = document.getElementById('sidebar-toggle');
          const previewGrid = document.querySelector('.preview-grid');
          const toggleText = sidebarToggle?.querySelector('.toggle-text');
          if (sidebarToggle && previewGrid) {
            sidebarToggle.addEventListener('click', () => {
              previewGrid.classList.toggle('sidebar-collapsed');
              if (toggleText) {
                toggleText.textContent = previewGrid.classList.contains('sidebar-collapsed') ? 'Show' : 'Hide';
              }
            });
          }
        })();
      </script>
    <% } %>
  </main>
</div>
