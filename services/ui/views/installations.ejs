<% layout('layout') %>

<style>
  :root {
    --bg-body: #121212;
    --bg-dashboard: #121212;
    --bg-card: #1A1A1A;
    --bg-card-hover: #202020;
    --border-color: #2A2A2A;
    --text-primary: #FFFFFF;
    --text-secondary: #9CA3AF;
    --text-muted: #6B7280;
    --green-accent: #4CD964;
    --red-accent: #FF5F56;
    --yellow-accent: #FFD700;
    --blue-accent: #0A84FF;
  }

  /* Layout Overrides */
  .navbar { display: none !important; }
  .footer-wave, .footer { display: block !important; }
  .main-content {
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    min-height: auto !important;
    display: contents !important;
  }
  
  body {
    background: var(--bg-body) !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text-primary);
    padding: 0 !important;
    margin: 0 !important;
    min-height: 100vh;
  }
  
  .installations-container {
    background: var(--bg-dashboard);
    display: block;
    min-height: 100vh;
    padding: 24px;
    /* padding-left: 94px; - Removed to fix double padding (sidebar margin handles offset) */
  }

  /* Hide old sidebar styles - use sidebar.ejs styles */
  .installations-container > .left-sidebar {
    position: fixed !important;
    left: 0 !important;
    top: 0 !important;
  }

  /* Main Content */
  .installations-main {
    padding: 0 32px;
    overflow-y: auto;
    max-height: calc(100vh - 48px);
  }

  /* Header */
  .page-head {
    margin-bottom: 20px;
  }
  .page-head h1 {
    font-size: 24px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }
  .page-head p {
    font-size: 13px;
    color: var(--text-secondary);
  }

  /* Stats Overview */
  .stats-overview {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 20px;
  }
  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 16px;
    transition: all 0.2s;
  }
  .stat-card:hover {
    border-color: #3a3a3a;
    transform: translateY(-2px);
  }
  .stat-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }
  .stat-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
  }
  .stat-icon {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .stat-value {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
  }
  .stat-change {
    font-size: 11px;
    color: var(--green-accent);
    margin-top: 4px;
  }

  /* Empty State */
  .empty-state {
    background: var(--bg-card);
    border: 2px dashed var(--border-color);
    border-radius: 16px;
    padding: 48px 32px;
    text-align: center;
  }
  .empty-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 16px;
    opacity: 0.3;
  }
  .empty-state h2 {
    font-size: 18px;
    color: var(--text-primary);
    margin-bottom: 8px;
  }
  .empty-state p {
    color: var(--text-muted);
    font-size: 13px;
    margin-bottom: 20px;
  }

  /* Installation Cards */
  .installation-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 18px;
    margin-bottom: 12px;
    transition: all 0.2s;
  }
  .installation-card:hover {
    border-color: #3a3a3a;
    background: var(--bg-card-hover);
  }

  .install-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: center;
    margin-bottom: 14px;
  }

  .install-avatar {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    border: 2px solid var(--border-color);
  }

  .install-info h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 5px;
  }
  .install-badges {
    display: flex;
    gap: 6px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
  }
  .badge-active {
    background: rgba(76, 217, 100, 0.15);
    color: var(--green-accent);
  }
  .badge-suspended {
    background: rgba(255, 95, 86, 0.15);
    color: var(--red-accent);
  }
  .badge-repos {
    background: rgba(10, 132, 255, 0.15);
    color: var(--blue-accent);
  }

  .install-actions {
    display: flex;
    gap: 8px;
  }

  /* Config Display */
  .config-display {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 12px;
  }
  .config-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 10px 12px;
  }
  .config-box-label {
    font-size: 10px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
    font-weight: 600;
  }
  .config-box-value {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Auto-merge Indicator */
  .automerge-indicator {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
  }
  .automerge-enabled {
    background: rgba(76, 217, 100, 0.15);
    color: var(--green-accent);
  }
  .automerge-disabled {
    background: rgba(156, 163, 175, 0.15);
    color: var(--text-muted);
  }

  /* Severity Badges */
  .severity-badges {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }
  .severity-badge {
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .severity-critical {
    background: rgba(255, 95, 86, 0.2);
    color: var(--red-accent);
    border: 1px solid rgba(255, 95, 86, 0.4);
  }
  .severity-high {
    background: rgba(255, 215, 0, 0.2);
    color: var(--yellow-accent);
    border: 1px solid rgba(255, 215, 0, 0.4);
  }
  .severity-medium {
    background: rgba(10, 132, 255, 0.2);
    color: var(--blue-accent);
    border: 1px solid rgba(10, 132, 255, 0.4);
  }
  .severity-low {
    background: rgba(156, 163, 175, 0.2);
    color: var(--text-secondary);
    border: 1px solid rgba(156, 163, 175, 0.4);
  }

  /* Repos Display */
  .repos-display {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
    margin-bottom: 10px;
  }
  .repo-tag {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-size: 12px;
    color: var(--text-secondary);
    transition: all 0.2s;
  }
  .repo-tag:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-primary);
    border-color: #3a3a3a;
  }
  .repo-icon {
    width: 14px;
    height: 14px;
    opacity: 0.6;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }
  .btn-sm {
    padding: 6px 12px;
    font-size: 11px;
  }
  .btn-primary {
    background: var(--green-accent);
    color: #000;
  }
  .btn-primary:hover {
    background: #5fe574;
    transform: scale(1.05);
  }
  .btn-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }
  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  .btn-danger {
    background: rgba(255, 95, 86, 0.12);
    color: var(--red-accent);
    border: 1px solid rgba(255, 95, 86, 0.3);
  }
  .btn-danger:hover {
    background: rgba(255, 95, 86, 0.2);
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 10px;
    border-top: 1px solid var(--border-color);
  }
  .meta-text {
    font-size: 10px;
    color: var(--text-muted);
  }

  .add-more-section {
    margin-top: 16px;
    text-align: center;
  }
</style>

<div class="installations-container">
  <%- include('partials/sidebar', { activePage: 'installations' }) %>
  
  <main class="installations-main">
    <div class="page-head">
      <h1>GitHub App Installations</h1>
      <p>Manage Peer integration with your repositories</p>
    </div>

    <%
      const totalInstalls = installations.length;
      const activeInstalls = installations.filter(i => i.status === 'active').length;
      const totalRepos = installations.reduce((sum, i) => sum + i.repositories.length, 0);
      const allReposCount = installations.filter(i => i.repositorySelection === 'all').length;
    %>

    <!-- Stats Overview -->
    <div class="stats-overview">
      <div class="stat-card">
        <div class="stat-card-header">
          <div class="stat-label">Installations</div>
          <div class="stat-icon" style="background: rgba(10, 132, 255, 0.15); color: var(--blue-accent);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
          </div>
        </div>
        <div class="stat-value"><%= totalInstalls %></div>
      </div>

      <div class="stat-card">
        <div class="stat-card-header">
          <div class="stat-label">Active</div>
          <div class="stat-icon" style="background: rgba(76, 217, 100, 0.15); color: var(--green-accent);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          </div>
        </div>
        <div class="stat-value"><%= activeInstalls %></div>
        <div class="stat-change">● <%= totalInstalls > 0 ? Math.round(activeInstalls/totalInstalls*100) : 0 %>% active</div>
      </div>

      <div class="stat-card">
        <div class="stat-card-header">
          <div class="stat-label">Repositories</div>
          <div class="stat-icon" style="background: rgba(255, 215, 0, 0.15); color: var(--yellow-accent);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
          </div>
        </div>
        <div class="stat-value"><%= totalRepos %></div>
      </div>

      <div class="stat-card">
        <div class="stat-card-header">
          <div class="stat-label">Full Access</div>
          <div class="stat-icon" style="background: rgba(156, 163, 175, 0.15); color: var(--text-secondary);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          </div>
        </div>
        <div class="stat-value"><%= allReposCount %></div>
      </div>
    </div>

    <% if (installations.length === 0) { %>
      <div class="empty-state">
        <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
        </svg>
        <h2>No Installations Yet</h2>
        <p>Install the Peer GitHub App to enable AI-powered code review</p>
        <a href="https://github.com/apps/peer-code-review-v2/installations/new" target="_blank" class="btn btn-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>
          Install GitHub App
        </a>
      </div>
    <% } else { %>
      <% installations.forEach(installation => { %>
        <div class="installation-card">
          <!-- Header -->
          <div class="install-header">
            <img src="<%= installation.accountAvatarUrl || `https://avatars.githubusercontent.com/u/${installation.accountId}?v=4` %>" 
                 alt="<%= installation.accountLogin %>" 
                 class="install-avatar"
                 onerror="this.src='https://github.com/identicons/<%= installation.accountId %>.png'">
            
            <div class="install-info">
              <h3><%= installation.accountLogin %></h3>
              <div class="install-badges">
                <span class="badge badge-<%= installation.status %>">
                  <% if (installation.status === 'active') { %>
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"></circle></svg>
                  <% } else { %>
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle></svg>
                  <% } %>
                  <%= installation.status %>
                </span>
                <span class="badge badge-repos">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                  <%= installation.repositorySelection === 'all' ? 'All Repos' : installation.repositories.length + ' Repos' %>
                </span>
              </div>
            </div>

            <div class="install-actions">
              <a href="/installations/<%= installation._id %>/settings" class="btn btn-secondary btn-sm">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M12 1v6m0 6v6m6-12h-6m-6 0H1"></path></svg>
                Configure
              </a>
              <button class="btn btn-danger btn-sm" onclick="deleteInstallation('<%= installation._id %>')">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                Delete
              </button>
            </div>
          </div>

          <!-- Config Display -->
          <div class="config-display">
            <div class="config-box">
              <div class="config-box-label">Processing Mode</div>
              <div class="config-box-value"><%= installation.config.mode.toUpperCase() %></div>
            </div>
            <div class="config-box">
              <div class="config-box-label">Max Files Per Run</div>
              <div class="config-box-value"><%= installation.config.maxFilesPerRun %> files</div>
            </div>
            <div class="config-box">
              <div class="config-box-label">Auto-Merge Status</div>
              <div class="config-box-value">
                <span class="automerge-indicator <%= installation.config.autoMerge.enabled ? 'automerge-enabled' : 'automerge-disabled' %>">
                  <% if (installation.config.autoMerge.enabled) { %>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    Enabled
                  <% } else { %>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    Disabled
                  <% } %>
                </span>
              </div>
            </div>
            <div class="config-box">
              <div class="config-box-label">Severity Levels</div>
              <div class="severity-badges">
                <% installation.config.severities.forEach(sev => { %>
                  <span class="severity-badge severity-<%= sev %>"><%= sev %></span>
                <% }); %>
              </div>
            </div>
          </div>

          <!-- Repos -->
          <% if (installation.repositories.length > 0 && installation.repositorySelection !== 'all') { %>
            <div class="repos-display">
              <% installation.repositories.slice(0, 4).forEach(repo => { %>
                <div class="repo-tag">
                  <svg class="repo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                  <%= repo.fullName.split('/')[1] || repo.fullName %>
                </div>
              <% }); %>
              <% if (installation.repositories.length > 4) { %>
                <div class="repo-tag" style="justify-content: center; opacity: 0.6;">
                  +<%= installation.repositories.length - 4 %> more
                </div>
              <% } %>
            </div>
          <% } %>

          <!-- Footer -->
          <div class="footer-row">
            <span class="meta-text">ID: <%= installation.installationId %> • <%= new Date(installation.installedAt).toLocaleDateString() %></span>
            <a href="https://github.com/settings/installations/<%= installation.installationId %>" target="_blank" class="btn btn-secondary btn-sm">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              GitHub Settings
            </a>
          </div>
        </div>
      <% }); %>
    <% } %>

    <div class="add-more-section">
      <a href="https://github.com/apps/peer-code-review-v2/installations/new" target="_blank" class="btn btn-primary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add More Repositories
      </a>
    </div>
  </main>
</div>

<script>
  async function deleteInstallation(id) {
    if (!confirm('Are you sure? This will remove Peer from these repositories.')) return;
    
    try {
      const response = await fetch(`/installations/${id}/delete`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      
      const data = await response.json();
      
      if (data.ok) {
        alert('Installation deleted successfully');
        window.location.reload();
      } else {
        alert('Failed to delete: ' + (data.error || 'Unknown error'));
      }
    } catch (error) {
      alert('Failed to delete: ' + error.message);
    }
  }
  
  // Sidebar toggle - wait for DOM
  document.addEventListener('DOMContentLoaded', function() {
    const sidebar = document.getElementById('sidebar');
    const toggleBtn = document.getElementById('sidebarToggle');
    const container = document.querySelector('.installations-container');
    
    if (sidebar && toggleBtn && container) {
      // Load saved state
      const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
      if (isCollapsed) {
        sidebar.classList.add('collapsed');
        container.classList.add('sidebar-collapsed');
      }
      
      // Toggle handler
      toggleBtn.addEventListener('click', function() {
        sidebar.classList.toggle('collapsed');
        container.classList.toggle('sidebar-collapsed');
        localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
      });
    }
  });
</script>
